<script>
  let itemToDeleteId = null;

  function openModal(id) {
    const modal = document.getElementById(id);
    if (modal) {
      modal.classList.remove('hidden');
    }
  }

  function closeModal(id) {
    const modal = document.getElementById(id);
    if (modal) {
      modal.classList.add('hidden');
    }
  }

  function showToast(message, type = 'success') {
    const container = document.getElementById('toast-container');
    if (!container) return;
    
    const toast = document.createElement('div');
    toast.className = `p-3 px-4 rounded-xl shadow-lg flex items-center gap-2 text-body-sm font-label-md pointer-events-auto transition-all transform duration-200 translate-y-2 opacity-0 ${
      type === 'success' ? 'bg-inverse-surface text-inverse-on-surface' : 'bg-error text-on-error'
    }`;
    toast.innerHTML = `
      <span class="material-symbols-outlined text-body-md">${type === 'success' ? 'check_circle' : 'info'}</span>
      <span>${message}</span>
    `;
    
    container.appendChild(toast);
    setTimeout(() => {
      toast.classList.remove('translate-y-2', 'opacity-0');
    }, 10);

    setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-2');
      setTimeout(() => toast.remove(), 250);
    }, 3200);
  }

  function printParticipantSummary() {
    showToast('Menyiapkan berkas cetak rekap peserta lomba...', 'success');
    setTimeout(() => {
      window.print();
    }, 600);
  }

  function selectCategory(categoryKey, btn) {
    const pills = document.querySelectorAll('.category-pill');
    pills.forEach(p => {
      p.classList.remove('bg-primary', 'text-on-primary', 'active');
      p.classList.add('bg-surface-container-low', 'text-on-surface-variant');
    });

    btn.classList.add('bg-primary', 'text-on-primary', 'active');
    btn.classList.remove('bg-surface-container-low', 'text-on-surface-variant');

    filterLombaTable();
  }

  function filterLombaTable() {
    const searchVal = document.getElementById('search-input').value.toLowerCase().trim();
    const activePill = document.querySelector('.category-pill.active');
    const selectedCatText = activePill ? activePill.innerText.trim() : 'Semua Kategori';

    const rows = document.querySelectorAll('#lomba-tbody tr');

    rows.forEach(row => {
      const searchData = row.getAttribute('data-search') || '';
      const rowCat = row.getAttribute('data-category') || '';

      const matchSearch = searchVal === '' || searchData.includes(searchVal);
      let matchCat = true;

      if (selectedCatText !== 'Semua Kategori') {
        if (selectedCatText.includes('Cosplay')) {
          matchCat = rowCat.includes('Cosplay');
        } else if (selectedCatText.includes('Musik')) {
          matchCat = rowCat.includes('Musik');
        } else if (selectedCatText.includes('Seni')) {
          matchCat = rowCat.includes('Seni');
        } else if (selectedCatText.includes('Kebudayaan')) {
          matchCat = rowCat.includes('Kebudayaan');
        }
      }

      if (matchSearch && matchCat) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }

  function viewDetail(id, title, cat, kuota, jadwal, lokasi, pic, desc) {
    document.getElementById('detail-id').innerText = id;
    document.getElementById('detail-title').innerText = title;
    document.getElementById('detail-badge').innerText = cat;
    document.getElementById('detail-kuota').innerText = kuota;
    document.getElementById('detail-jadwal').innerText = jadwal;
    document.getElementById('detail-lokasi').innerText = lokasi;
    document.getElementById('detail-pic').innerText = pic;
    document.getElementById('detail-desc').innerText = desc;
    openModal('modal-detail-lomba');
  }

  function editLomba(id, nama, kategori, kuota, jadwal, lokasi, pic) {
    document.getElementById('modal-form-title').innerText = 'Sunting Data Lomba - ' + id;
    document.getElementById('form-lomba-id').value = id;
    document.getElementById('nama_lomba').value = nama;
    document.getElementById('kategori_lomba').value = kategori;
    document.getElementById('kuota').value = kuota;
    document.getElementById('jadwal').value = jadwal;
    document.getElementById('lokasi').value = lokasi;
    document.getElementById('id_panitia').value = pic;
    document.getElementById('deskripsi').value = 'Formulir diperbarui untuk penyesuaian pendaftaran dan waktu.';
    openModal('modal-form-lomba');
  }

  function confirmDelete(id, nama) {
    itemToDeleteId = id;
    document.getElementById('delete-lomba-name').innerText = nama + ' (' + id + ')';
    openModal('modal-delete-lomba');
  }

  function executeDelete() {
    closeModal('modal-delete-lomba');
    showToast('Lomba ' + (itemToDeleteId || '') + ' berhasil dihapus dari sistem.', 'success');
    itemToDeleteId = null;
  }

  function handleFormSubmit(e) {
    e.preventDefault();
    const id = document.getElementById('form-lomba-id').value;
    const nama = document.getElementById('nama_lomba').value;
    closeModal('modal-form-lomba');
    
    if (id) {
      showToast(`Perubahan data "${nama}" berhasil disimpan!`, 'success');
    } else {
      showToast(`Lomba baru "${nama}" berhasil didaftarkan!`, 'success');
    }

    document.getElementById('lomba-form').reset();
    document.getElementById('form-lomba-id').value = '';
    document.getElementById('modal-form-title').innerText = 'Tambah Cabang Lomba Baru';
  }
</script></main></div><div class="relative z-50" id="modal-root"></div><div class="fixed bottom-space-lg right-space-lg z-50 flex flex-col gap-space-sm pointer-events-none" id="toast-container"></div></body></html>