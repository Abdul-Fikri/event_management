<!-- Toast Notification Wrapper -->
<div class="fixed bottom-6 right-6 z-50 transform translate-y-24 opacity-0 transition-all duration-300 pointer-events-none flex items-center gap-space-xs px-4 py-3 rounded-xl bg-inverse-surface text-inverse-on-surface shadow-lg" id="liveToast">
<span class="material-symbols-outlined text-primary-fixed-dim" id="toastIcon">check_circle</span>
<span class="font-body-md text-body-md" id="toastMessage">Operasi berhasil dilakukan.</span>
</div>
</div>
<script>
  let targetDeleteId = null;

  function showToast(message, isSuccess = true) {
    const toast = document.getElementById('liveToast');
    const toastMsg = document.getElementById('toastMessage');
    const toastIcon = document.getElementById('toastIcon');
    
    toastMsg.textContent = message;
    toastIcon.textContent = isSuccess ? 'check_circle' : 'info';
    toastIcon.className = isSuccess ? 'material-symbols-outlined text-primary-fixed-dim' : 'material-symbols-outlined text-error';

    toast.classList.remove('translate-y-24', 'opacity-0');
    toast.classList.add('translate-y-0', 'opacity-100');

    setTimeout(() => {
      toast.classList.add('translate-y-24', 'opacity-0');
      toast.classList.remove('translate-y-0', 'opacity-100');
    }, 3200);
  }

  function openTenantModal(mode, tenantId = null) {
    const modal = document.getElementById('tenantModal');
    const title = document.getElementById('modalTitle');
    const form = document.getElementById('tenantForm');
    const idField = document.getElementById('editTenantId');

    if (mode === 'edit' && tenantId) {
      title.textContent = 'Edit Data Stan ' + tenantId;
      idField.value = tenantId;
      // Pre-fill demo values based on ID
      if (tenantId === 'TNT-01') {
        document.getElementById('tenantName').value = 'Osaka Takoyaki Master';
        document.getElementById('boothType').value = 'Kuliner (F&B)';
        document.getElementById('boothZone').value = 'Zona B - Outdoor Kuliner';
        document.getElementById('boothNumber').value = 'B-01';
        document.getElementById('panitiaPIC').value = 'Rian Ardiansyah';
        document.getElementById('tenantContact').value = '0812-3456-7890';
        document.getElementById('tenantEmail').value = 'takoyaki@osaka-fest.id';
      } else if (tenantId === 'TNT-03') {
        document.getElementById('tenantName').value = 'Akiba Figure & Nendoroid Hub';
        document.getElementById('boothType').value = 'Merchandise';
        document.getElementById('boothZone').value = 'Zona A - Selasar Utama';
        document.getElementById('boothNumber').value = 'A-01';
        document.getElementById('panitiaPIC').value = 'Hendra Kurniawan';
        document.getElementById('tenantContact').value = '0877-9876-5432';
        document.getElementById('tenantEmail').value = 'halo@akibahub.co.id';
      }
    } else {
      title.textContent = 'Tambah Data Tenant Baru';
      idField.value = '';
      form.reset();
    }

    modal.classList.remove('hidden');
  }

  function closeTenantModal() {
    document.getElementById('tenantModal').classList.add('hidden');
  }

  function toggleMapModal(show) {
    const map = document.getElementById('mapModal');
    if (show) {
      map.classList.remove('hidden');
    } else {
      map.classList.add('hidden');
    }
  }

  function handleFormSubmit(e) {
    e.preventDefault();
    const id = document.getElementById('editTenantId').value;
    const name = document.getElementById('tenantName').value;

    closeTenantModal();
    if (id) {
      showToast('Perubahan data tenant ' + id + ' berhasil disimpan.');
    } else {
      showToast('Tenant baru "' + name + '" sukses ditambahkan ke daftar.');
    }
  }

  function openDeleteDialog(id, name) {
    targetDeleteId = id;
    document.getElementById('deleteTargetId').textContent = id;
    document.getElementById('deleteTargetName').textContent = name;
    document.getElementById('deleteModal').classList.remove('hidden');
  }

  function closeDeleteDialog() {
    document.getElementById('deleteModal').classList.add('hidden');
    targetDeleteId = null;
  }

  function confirmDeleteAction() {
    if (targetDeleteId) {
      showToast('Data tenant ' + targetDeleteId + ' berhasil dihapus dari sistem.', true);
      closeDeleteDialog();
    }
  }

  function filterTenantTable() {
    const searchVal = document.getElementById('searchInput').value.toLowerCase();
    const catVal = document.getElementById('categoryFilter').value;
    const zoneVal = document.getElementById('zoneFilter').value;

    const rows = document.querySelectorAll('#tenantTableBody tr');
    let visibleCount = 0;

    rows.forEach(row => {
      const rowText = row.innerText.toLowerCase();
      const rowCat = row.getAttribute('data-category');
      const rowZone = row.getAttribute('data-zone');

      const matchesSearch = rowText.includes(searchVal);
      const matchesCat = (catVal === 'all') || (rowCat === catVal);
      const matchesZone = (zoneVal === 'all') || (rowZone === zoneVal);

      if (matchesSearch && matchesCat && matchesZone) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
      }
    });

    const notice = document.getElementById('paginationNotice');
    notice.innerHTML = 'Menampilkan <span class="font-semibold text-on-surface">' + visibleCount + '</span> tenant terfilter';
  }

  function resetFilters() {
    document.getElementById('searchInput').value = '';
    document.getElementById('categoryFilter').value = 'all';
    document.getElementById('zoneFilter').value = 'all';
    filterTenantTable();
    showToast('Filter pencarian telah dibersihkan');
  }

  function quickFilterBooth(boothCode) {
    document.getElementById('searchInput').value = boothCode;
    filterTenantTable();
    showToast('Memfilter stan: ' + boothCode);
  }
</script></main></div><div class="relative z-50" id="modal-root"></div><div class="fixed bottom-space-lg right-space-lg z-50 flex flex-col gap-space-sm pointer-events-none" id="toast-container"></div></body></html>