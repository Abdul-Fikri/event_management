            Batal
          </button>
<button class="h-10 px-space-md rounded-lg bg-primary hover:bg-primary-container hover:text-on-primary-container text-on-primary font-title-sm text-title-sm shadow-md transition-all flex items-center gap-space-xs" type="submit">
<span class="material-symbols-outlined text-body-md">save</span>
<span>Simpan Divisi</span>
</button>
</div>
</form>
</div>
</div>
<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-on-surface/40 backdrop-blur-sm hidden opacity-0 transition-opacity duration-200" id="modalConfirmDelete">
<div class="bg-surface-container-lowest rounded-xl shadow-xl w-full max-w-md p-space-lg transform scale-95 transition-transform duration-200" id="deleteCard">
<div class="w-12 h-12 rounded-full bg-error-container text-on-error-container flex items-center justify-center mb-space-sm">
<span class="material-symbols-outlined text-headline-lg">warning</span>
</div>
<h3 class="font-headline-md text-headline-md text-on-surface mb-1">Konfirmasi Hapus Divisi</h3>
<p class="font-body-md text-body-md text-on-surface-variant mb-space-lg" id="deletePromptText">
        Apakah Anda yakin ingin menghapus divisi ini? Tindakan ini tidak dapat dibatalkan dan akan mempengaruhi alokasi panitia.
      </p>
<div class="flex items-center justify-end gap-space-sm">
<button class="h-10 px-space-md rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-title-sm text-title-sm transition-colors" onclick="closeModal('modalConfirmDelete')" type="button">
          Batal
        </button>
<button class="h-10 px-space-md rounded-lg bg-error text-on-error hover:bg-on-error-container transition-colors font-title-sm text-title-sm shadow-sm" onclick="executeDelete()" type="button">
          Ya, Hapus Divisi
        </button>
</div>
</div>
</div>
<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-on-surface/40 backdrop-blur-sm hidden opacity-0 transition-opacity duration-200" id="modalDetailDivisi">
<div class="bg-surface-container-lowest rounded-xl shadow-xl w-full max-w-lg p-space-lg transform scale-95 transition-transform duration-200" id="detailCard">
<div class="flex items-center justify-between pb-space-sm mb-space-md">
<div class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-primary text-headline-md">info</span>
<h3 class="font-headline-md text-headline-md text-on-surface" id="detailModalTitle">Detail Divisi</h3>
</div>
<button class="text-on-surface-variant hover:text-on-surface p-1 rounded-lg hover:bg-surface-container transition-colors" onclick="closeModal('modalDetailDivisi')" type="button">
<span class="material-symbols-outlined">close</span>
</button>
</div>
<div class="space-y-space-md">
<div class="p-space-sm rounded-lg bg-surface-container-low flex items-center justify-between">
<div>
<span class="font-label-sm text-label-sm text-on-surface-variant">Kode ID Divisi</span>
<div class="font-title-sm text-title-sm text-primary font-mono font-bold" id="detailId">DIV-01</div>
</div>
<span class="px-2.5 py-1 rounded-full bg-primary/10 text-primary font-label-sm text-label-sm font-semibold">Aktif Operasional</span>
</div>
<div class="grid grid-cols-2 gap-space-sm">
<div class="p-space-sm rounded-lg bg-surface-container-low">
<span class="font-label-sm text-label-sm text-on-surface-variant">Koordinator</span>
<div class="font-title-sm text-title-sm text-on-surface font-semibold" id="detailKoor">-</div>
</div>
<div class="p-space-sm rounded-lg bg-surface-container-low">
<span class="font-label-sm text-label-sm text-on-surface-variant">Jumlah Anggota</span>
<div class="font-title-sm text-title-sm text-on-surface font-semibold" id="detailAnggota">-</div>
</div>
</div>
<div class="p-space-sm rounded-lg bg-surface-container-low">
<span class="font-label-sm text-label-sm text-on-surface-variant mb-1 block">Tingkat Pemenuhan Kuota</span>
<div class="flex items-center justify-between text-on-surface font-label-md text-label-md mb-1.5">
<span id="detailQuotaText">0 dari 0 Kuota</span>
<span class="font-bold text-primary" id="detailPercent">0%</span>
</div>
<div class="w-full bg-surface-container-highest rounded-full h-2">
<div class="bg-primary h-2 rounded-full" id="detailProgressBar" style="width: 0%"></div>
</div>
</div>
</div>
<div class="mt-space-lg flex justify-end">
<button class="h-10 px-space-md rounded-lg bg-primary text-on-primary hover:bg-primary-container hover:text-on-primary-container font-title-sm text-title-sm transition-colors" onclick="closeModal('modalDetailDivisi')" type="button">
          Tutup
        </button>
</div>
</div>
</div>
<script>
    let activeDivisiToDelete = null;

    function openModal(id) {
      const modal = id === 'modal-tambah' ? document.getElementById('modalTambahDivisi') : document.getElementById(id);
      if (!modal) return;
      
      if (id === 'modal-tambah') {
        document.getElementById('modalTitle').textContent = 'Tambah Divisi Baru';
        document.getElementById('formActionType').value = 'add';
        document.getElementById('divisiForm').reset();
      }

      modal.classList.remove('hidden');
      setTimeout(() => {
        modal.classList.remove('opacity-0');
        const card = modal.querySelector('div[id$="Card"]');
        if (card) {
          card.classList.remove('scale-95');
          card.classList.add('scale-100');
        }
      }, 10);
    }

    function closeModal(id) {
      const modal = document.getElementById(id);
      if (!modal) return;
      modal.classList.add('opacity-0');
      const card = modal.querySelector('div[id$="Card"]');
      if (card) {
        card.classList.remove('scale-100');
        card.classList.add('scale-95');
      }
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 200);
    }

    function editDivisi(id, nama, kuota) {
      document.getElementById('modalTitle').textContent = 'Ubah Data Divisi: ' + id;
      document.getElementById('formActionType').value = 'edit';
      document.getElementById('editDivisiId').value = id;
      document.getElementById('namaDivisi').value = nama;
      document.getElementById('targetKuota').value = kuota;
      document.getElementById('deskripsiTugas').value = 'Divisi ini bertanggung jawab penuh atas pelaksanaan aspek ' + nama + ' pada festival.';
      openModal('modalTambahDivisi');
    }

    function confirmDelete(id, nama) {
      activeDivisiToDelete = id;
      document.getElementById('deletePromptText').textContent = 'Apakah Anda yakin ingin menghapus "' + nama + '" (' + id + ')? Tindakan ini akan menghapus alokasi anggota terkait.';
      openModal('modalConfirmDelete');
    }

    function executeDelete() {
      if (!activeDivisiToDelete) return;
      const rows = document.querySelectorAll('#divisiTable tbody tr');
      rows.forEach(r => {
        if (r.getAttribute('data-id') === activeDivisiToDelete) {
          r.remove();
        }
      });
      closeModal('modalConfirmDelete');
      showToast('Data divisi berhasil dihapus dari sistem.', 'success');
      activeDivisiToDelete = null;
      updateTotalDivisiCount();
    }

    function viewDetail(id, nama, ang, kuota, koor) {
      document.getElementById('detailModalTitle').textContent = nama;
      document.getElementById('detailId').textContent = id;
      document.getElementById('detailKoor').textContent = koor;
      document.getElementById('detailAnggota').textContent = ang + ' Panitia';
      document.getElementById('detailQuotaText').textContent = ang + ' dari ' + kuota + ' Kuota';
      const pct = Math.round((parseInt(ang) / parseInt(kuota)) * 100);
      document.getElementById('detailPercent').textContent = pct + '%';
      document.getElementById('detailProgressBar').style.width = pct + '%';
      openModal('modalDetailDivisi');
    }

    function handleFormSubmit(e) {
      e.preventDefault();
      const nama = document.getElementById('namaDivisi').value.trim();
      const kuota = document.getElementById('targetKuota').value;
      const action = document.getElementById('formActionType').value;

      if (action === 'add') {
        const tbody = document.querySelector('#divisiTable tbody');
        const count = tbody.querySelectorAll('tr').length + 1;
        const newId = 'DIV-0' + (count < 10 ? '0' + count : count);
        
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-surface-container-low/60 transition-colors group';
        tr.setAttribute('data-id', newId);
        tr.setAttribute('data-nama', nama);
        tr.setAttribute('data-ang', '0');
        tr.setAttribute('data-kuota', kuota);
        tr.setAttribute('data-koor', 'Belum Ditunjuk');
        
        tr.innerHTML = `
          <td class="py-space-sm px-space-md text-center text-on-surface-variant font-label-md">${count}</td>
          <td class="py-space-sm px-space-md">
            <span class="px-2 py-0.5 rounded bg-surface-container text-primary font-mono font-label-sm text-label-sm font-semibold">${newId}</span>
          </td>
          <td class="py-space-sm px-space-md font-medium text-on-surface">${nama}</td>
          <td class="py-space-sm px-space-md">
            <span class="inline-flex items-center gap-1 font-label-md text-label-md text-on-surface">
              <span class="material-symbols-outlined text-body-sm text-primary">person</span>
              0 Panitia
            </span>
          </td>
          <td class="py-space-sm px-space-md">
            <div class="space-y-1">
              <div class="flex justify-between font-label-sm text-label-sm text-on-surface-variant">
                <span>0/${kuota} Kuota</span>
                <span class="font-semibold text-primary">0%</span>
              </div>
              <div class="w-full bg-surface-container rounded-full h-1.5 overflow-hidden">
                <div class="bg-primary h-1.5 rounded-full" style="width: 0%"></div>
              </div>
            </div>
          </td>
          <td class="py-space-sm px-space-md text-on-surface-variant italic">Belum Ditunjuk</td>
          <td class="py-space-sm px-space-md text-right">
            <div class="flex items-center justify-end gap-space-xs">
              <button type="button" onclick="viewDetail('${newId}', '${nama}', '0', '${kuota}', 'Belum Ditunjuk')" class="p-1 rounded text-primary hover:bg-surface-container transition-colors" title="Detail Divisi">
                <span class="material-symbols-outlined text-body-md">visibility</span>
              </button>
              <button type="button" onclick="editDivisi('${newId}', '${nama}', ${kuota})" class="p-1 rounded text-secondary hover:bg-surface-container transition-colors" title="Edit Divisi">
                <span class="material-symbols-outlined text-body-md">edit</span>
              </button>
              <button type="button" onclick="confirmDelete('${newId}', '${nama}')" class="p-1 rounded text-error hover:bg-error-container/30 transition-colors" title="Hapus Divisi">
                <span class="material-symbols-outlined text-body-md">delete</span>
              </button>
            </div>
          </td>
        `;
        tbody.appendChild(tr);
        showToast('Divisi "' + nama + '" berhasil ditambahkan.', 'success');
      } else {
        const editId = document.getElementById('editDivisiId').value;
        const rows = document.querySelectorAll('#divisiTable tbody tr');
        rows.forEach(r => {
          if (r.getAttribute('data-id') === editId) {
            r.setAttribute('data-nama', nama);
            r.setAttribute('data-kuota', kuota);
            r.children[2].textContent = nama;
          }
        });
        showToast('Divisi ' + editId + ' berhasil diperbarui.', 'success');
      }

      closeModal('modalTambahDivisi');
      updateTotalDivisiCount();
    }

    function updateTotalDivisiCount() {
      const count = document.querySelectorAll('#divisiTable tbody tr').length;
      const countLabel = document.getElementById('divisiCountLabel');
      if (countLabel) countLabel.textContent = count + ' Divisi';
    }

    function filterDivisiTable() {
      const q = document.getElementById('searchInput').value.toLowerCase();
      const rows = document.querySelectorAll('#divisiTable tbody tr');
      let visible = 0;
      rows.forEach(r => {
        const text = r.innerText.toLowerCase();
        if (text.includes(q)) {
          r.style.display = '';
          visible++;
        } else {
          r.style.display = 'none';
        }
      });
      const countLabel = document.getElementById('divisiCountLabel');
      if (countLabel) countLabel.textContent = visible + ' Divisi';
    }

    function showToast(message, type = 'info') {
      const toastContainer = document.getElementById('toast-container');
      if (!toastContainer) return;
      const toast = document.createElement('div');
      toast.className = 'flex items-center gap-2 px-4 py-3 rounded-lg shadow-lg bg-surface-container-lowest text-on-surface font-body-md text-body-md transform transition-all duration-300 translate-y-2 pointer-events-auto';
      
      const icon = type === 'success' ? 'check_circle' : 'info';
      const iconColor = type === 'success' ? 'text-primary' : 'text-secondary';
      
      toast.innerHTML = `
        <span class="material-symbols-outlined ${iconColor}">${icon}</span>
        <span>${message}</span>
      `;
      
      toastContainer.appendChild(toast);
      setTimeout(() => {
        toast.classList.remove('translate-y-2');
        toast.classList.add('translate-y-0');
      }, 10);

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }
  </script>
</div></main></div><div class="relative z-50" id="modal-root"></div><div class="fixed bottom-space-lg right-space-lg z-50 flex flex-col gap-space-sm pointer-events-none" id="toast-container"></div></body></html>