    </p>
<div class="flex items-center justify-center gap-space-sm mt-space-lg">
<button class="px-4 py-2 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low transition-colors font-label-md text-label-md" onclick="closeDeleteModal()" type="button">
        Batal
      </button>
<button class="px-5 py-2 rounded-lg bg-error text-on-error font-label-md text-label-md hover:bg-on-error-container transition-all shadow-sm" onclick="proceedDelete()" type="button">
        Ya, Hapus
      </button>
</div>
</div>
</div>
<!-- Scripts for interactivity: Filter, Modals, Search, and Toast -->
<script is:inline>
  let pendingDeleteId = null;
  let currentPage = 1;
  const rowsPerPage = 4;
  let activeDay = 'hari1';
  let activeLocation = 'Semua Lokasi';
  let searchQuery = '';

  function getFilteredRows() {
    return [...document.querySelectorAll('#rundownTableBody tr')].filter((row) => {
      const dayMatches = activeDay === 'all' || row.dataset.day === activeDay;
      const locationMatches = activeLocation === 'Semua Lokasi' || (row.dataset.lokasi || '').toLowerCase().includes(activeLocation.toLowerCase());
      const searchMatches = !searchQuery || row.innerText.toLowerCase().includes(searchQuery);
      return dayMatches && locationMatches && searchMatches;
    });
  }

  function updateMetrics(rows = getFilteredRows()) {
    const venues = new Set(rows.map((row) => row.dataset.lokasi).filter(Boolean));
    const coordinators = new Set(rows.map((row) => row.children[4]?.innerText.trim()).filter(Boolean));
    const liveRow = rows.find((row) => row.innerText.includes('Berlangsung'));
    const liveTitle = liveRow?.children[2]?.innerText.trim().split('\n')[0] || 'Belum ada sesi aktif';
    document.getElementById('metric-total-sessions').textContent = `${rows.length} Sesi`;
    document.getElementById('metric-venue-count').textContent = `${venues.size} Titik`;
    document.getElementById('metric-pic-count').textContent = `${coordinators.size} Panitia`;
    document.getElementById('metric-live-status').textContent = liveRow ? 'Live' : 'Menunggu';
    document.getElementById('metric-live-title').textContent = liveTitle;
  }

  function renderPagination() {
    const rows = [...document.querySelectorAll('#rundownTableBody tr')];
    const filteredRows = getFilteredRows();
    const totalPages = Math.max(1, Math.ceil(filteredRows.length / rowsPerPage));
    currentPage = Math.min(currentPage, totalPages);
    const start = (currentPage - 1) * rowsPerPage;
    const pageRows = filteredRows.slice(start, start + rowsPerPage);

    rows.forEach((row) => { row.style.display = pageRows.includes(row) ? '' : 'none'; });
    document.getElementById('total-count').textContent = filteredRows.length;
    document.getElementById('showing-count').textContent = filteredRows.length ? `${start + 1}-${Math.min(start + rowsPerPage, filteredRows.length)}` : '0';

    const pageButtons = document.getElementById('pagination-pages');
    pageButtons.innerHTML = '';
    for (let page = 1; page <= totalPages; page++) {
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = page;
      button.className = page === currentPage
        ? 'px-3 py-1.5 rounded-lg bg-primary text-on-primary font-label-sm text-label-sm font-semibold shadow-sm'
        : 'px-3 py-1.5 rounded-lg bg-surface-container-low text-on-surface-variant hover:bg-surface-container font-label-sm text-label-sm transition-colors';
      button.addEventListener('click', () => { currentPage = page; renderPagination(); });
      pageButtons.appendChild(button);
    }
    document.getElementById('pagination-prev').disabled = currentPage === 1 || !filteredRows.length;
    document.getElementById('pagination-next').disabled = currentPage === totalPages || !filteredRows.length;
    updateMetrics(filteredRows);
  }

  function showToast(message, type = 'success') {
    const toastContainer = document.getElementById('toast-container');
    if (!toastContainer) return;

    const toast = document.createElement('div');
    toast.className = `flex items-center gap-2 px-4 py-3 rounded-xl shadow-lg transition-all transform translate-y-2 opacity-0 text-body-md font-body-md ${
      type === 'success' 
        ? 'bg-surface-container-lowest text-primary ring-1 ring-primary-container' 
        : 'bg-error text-on-error'
    }`;
    toast.innerHTML = `
      <span class="material-symbols-outlined text-headline-md">${type === 'success' ? 'check_circle' : 'error'}</span>
      <span>${message}</span>
    `;

    toastContainer.appendChild(toast);

    // Trigger animate-in
    requestAnimationFrame(() => {
      toast.classList.remove('translate-y-2', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');
    });

    setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-2');
      setTimeout(() => toast.remove(), 300);
    }, 3500);
  }

  function filterByDay(button, dayKey) {
    document.querySelectorAll('.day-filter-btn').forEach(btn => {
      btn.className = "day-filter-btn px-3.5 py-1.5 rounded-md font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-lowest/60 transition-all";
      const dot = btn.querySelector('.rounded-full');
      if (dot) dot.remove();
    });

    button.className = "day-filter-btn px-3.5 py-1.5 rounded-md font-label-md text-label-md bg-surface-container-lowest text-primary shadow-sm transition-all flex items-center gap-1.5";
    const dot = document.createElement('span');
    dot.className = "w-1.5 h-1.5 rounded-full bg-primary";
    button.prepend(dot);
    activeDay = dayKey;
    currentPage = 1;
    renderPagination();
    showToast(`Menampilkan jadwal untuk: ${button.innerText.trim()} (${getFilteredRows().length} sesi)`);
  }

  function filterByLocation(selectedLocation) {
    activeLocation = selectedLocation;
    currentPage = 1;
    renderPagination();
    showToast(`Filter Lokasi: ${selectedLocation} (${getFilteredRows().length} sesi ditemukan)`);
  }

  function handleSearch(query) {
    searchQuery = query.toLowerCase().trim();
    currentPage = 1;
    renderPagination();
  }

  document.getElementById('pagination-prev').addEventListener('click', () => { currentPage--; renderPagination(); });
  document.getElementById('pagination-next').addEventListener('click', () => { currentPage++; renderPagination(); });
  renderPagination();

  function handleExportPdf() {
    const source = document.querySelector('#rundown-print-area table');
    const printWindow = window.open('', '_blank', 'width=1000,height=800');
    if (!source || !printWindow) {
      showToast('Izinkan pop-up browser untuk mencetak rundown.', 'error');
      return;
    }

    const table = source.cloneNode(true);
    table.querySelectorAll('button').forEach((element) => element.remove());
    table.querySelectorAll('tr').forEach((row) => {
      if (row.style.display === 'none') row.remove();
    });
    const activeDayLabel = document.querySelector('#dayTabs .bg-surface-container-lowest')?.innerText.trim() || 'Semua Hari';
    const sessionCount = table.querySelectorAll('tbody tr').length;

    printWindow.document.write(`<!doctype html><html lang="id"><head><meta charset="utf-8"><title>Rundown-Takumi-Fest-2025</title><style>
      * { box-sizing: border-box; } body { font-family: Arial, sans-serif; color: #0d1c2f; margin: 32px; font-size: 12px; }
      h1 { font-size: 26px; margin: 0 0 8px; } h2, h3 { margin: 0 0 6px; } p, span { line-height: 1.45; }
      table { width: 100%; border-collapse: collapse; margin-top: 20px; } th { background: #e6eeff; text-align: left; }
      th, td { border: 1px solid #c0c7cf; padding: 8px; vertical-align: top; } .hidden, [hidden] { display: none !important; }
      @page { size: A4 landscape; margin: 12mm; } @media print { body { margin: 0; } }
    </style></head><body><h1>Rundown Kegiatan</h1><p>Takumi Festival 2025 — ${activeDayLabel}</p><p class="meta">${sessionCount} sesi kegiatan ditampilkan</p>${table.outerHTML}</body></html>`);
    printWindow.onload = () => { printWindow.focus(); printWindow.print(); };
    printWindow.document.close();
  }

  function openModal(mode = 'tambah') {
    const modal = document.getElementById('rundownModal');
    const modalTitle = document.getElementById('modalTitle');
    const form = document.getElementById('rundownForm');

    if (mode === 'tambah') {
      modalTitle.innerText = 'Tambah Jadwal Kegiatan';
      form.reset();
      document.getElementById('editRowId').value = '';
    }
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    const modal = document.getElementById('rundownModal');
    modal.classList.add('hidden');
    document.body.style.overflow = '';
  }

  function editRow(id) {
    const row = document.querySelector(`tr[data-id="${id}"]`);
    if (!row) return;

    openModal('edit');
    document.getElementById('modalTitle').innerText = 'Edit Jadwal Kegiatan';
    document.getElementById('editRowId').value = id;

    // Prefill title
    const titleEl = row.querySelector('.font-title-sm');
    if (titleEl) {
      document.getElementById('inputNamaKegiatan').value = titleEl.innerText.trim();
    }
  }

  function handleSaveRundown(e) {
    e.preventDefault();
    const isEdit = Boolean(document.getElementById('editRowId').value);
    const namaKegiatan = document.getElementById('inputNamaKegiatan').value;

    closeModal();
    if (isEdit) {
      showToast(`Jadwal "${namaKegiatan}" berhasil diperbarui!`);
    } else {
      showToast(`Jadwal "${namaKegiatan}" berhasil ditambahkan ke Rundown!`);
    }
  }

  function confirmDelete(id, name) {
    pendingDeleteId = id;
    document.getElementById('deleteItemTitle').innerText = `"${name}"`;
    document.getElementById('deleteModal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeDeleteModal() {
    pendingDeleteId = null;
    document.getElementById('deleteModal').classList.add('hidden');
    document.body.style.overflow = '';
  }

  function proceedDelete() {
    if (!pendingDeleteId) return;
    const row = document.querySelector(`tr[data-id="${pendingDeleteId}"]`);
    if (row) {
      row.style.transition = 'all 0.3s ease';
      row.style.opacity = '0';
      row.style.transform = 'translateX(20px)';
      setTimeout(() => {
        row.remove();
      }, 300);
    }
    closeDeleteModal();
    showToast('Sesi kegiatan berhasil dihapus dari rundown.', 'error');
  }

  // Close modals upon clicking outside or pressing Escape
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeModal();
      closeDeleteModal();
    }
  });
</script>
