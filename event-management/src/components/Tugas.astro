---
const columns = [
  { id: 'todo', title: 'Belum Dikerjakan', icon: 'radio_button_unchecked', tone: 'text-tertiary', items: [
    ['Tenant', 'Briefing Final Tenant Kuliner & Booth Sponsor', '1/3', 'RA', 'Rania Anindya', '17 Okt 2025'],
    ['Acara', 'Finalisasi Rundown Opening Ceremony', '2/5', 'DS', 'Dimas Saputra', '17 Okt 2025'],
    ['Logistik', 'Inventarisasi Meja dan Kursi Area Festival', '0/4', 'MF', 'Mira Fadila', '18 Okt 2025'],
    ['Publikasi', 'Unggah Denah Lokasi dan Informasi Parkir', '0/2', 'NA', 'Nadia Aulia', '18 Okt 2025']
  ]},
  { id: 'in-progress', title: 'Sedang Dikerjakan', icon: 'sync', tone: 'text-primary', items: [
    ['Perlengkapan', 'Setting Stage Rigging & Barricade VIP', '3/5', 'AP', 'Andi Pratama', '16 Okt 2025'],
    ['Sponsor', 'Konfirmasi Benefit Media Partner', '2/3', 'SP', 'Salsa Putri', '16 Okt 2025'],
    ['Keamanan', 'Koordinasi Jalur Evakuasi dan Pos Medis', '1/4', 'BF', 'Bagas Fikri', '17 Okt 2025'],
    ['Lomba', 'Rekap Peserta Kompetisi Cosplay', '4/6', 'RD', 'Rizky Dwi', '17 Okt 2025'],
    ['Acara', 'Gladi Bersih Penampilan Komunitas', '2/4', 'YA', 'Yusuf Ardi', '18 Okt 2025']
  ]},
  { id: 'done', title: 'Selesai', icon: 'task_alt', tone: 'text-primary', items: [
    ['Humas', 'Konfirmasi Kehadiran Tamu Undangan', '3/3', 'NP', 'Nisa Putri', '14 Okt 2025'],
    ['Sponsor', 'Penandatanganan Kontrak Sponsor Utama', '2/2', 'FI', 'Farhan Iqbal', '14 Okt 2025'],
    ['Humas', 'Surat Izin Keramaian & Koordinasi Keamanan Polres', '4/4', 'EP', 'Eko Prasetyo', '14 Okt 2025'],
    ['Desain', 'Cetak Backdrop Utama & Banner Penunjuk Arah', '3/3', 'KA', 'Kevin Aris', '15 Okt 2025']
  ]}
];
---

<div class="flex flex-col w-full">
  <section class="flex flex-col gap-space-lg mb-space-lg">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-space-md">
      <div class="flex flex-col gap-space-xs">
        <nav class="flex items-center text-on-surface-variant font-label-sm text-label-sm">
          <span>Beranda</span><span class="material-symbols-outlined text-body-sm mx-space-xs text-outline">chevron_right</span>
          <span>Tugas</span><span class="material-symbols-outlined text-body-sm mx-space-xs text-outline">chevron_right</span>
          <span class="text-primary font-title-sm text-title-sm">Papan Kanban</span>
        </nav>
        <div class="flex items-center gap-space-sm mt-1">
          <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Manajemen Tugas</h1>
          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-surface-container-high text-primary font-label-sm text-label-sm font-semibold"><span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>Real-time Sync</span>
        </div>
        <p class="font-body-md text-body-md text-on-surface-variant max-w-3xl">Kelola alur kerja dan progres tugas panitia Takumi Festival secara visual bergaya papan Kanban. Seret dan letakkan kartu tugas sesuai tahapan eksekusi lapangan.</p>
      </div>
      <div class="flex flex-wrap items-center gap-space-sm self-start md:self-auto">
        <button id="filterBtn" class="flex items-center gap-space-xs px-3.5 py-2.5 rounded-xl bg-surface-container-lowest text-on-surface-variant shadow-sm font-label-md text-label-md" type="button"><span class="material-symbols-outlined text-[18px] text-primary">filter_list</span>Semua Divisi<span class="material-symbols-outlined text-[18px] text-outline">expand_more</span></button>
        <button class="flex items-center gap-space-xs px-3.5 py-2.5 rounded-xl bg-surface-container-lowest text-on-surface-variant shadow-sm font-label-md text-label-md" type="button"><span class="material-symbols-outlined text-[18px]">calendar_month</span>H-3 Festival</button>
        <button id="openModalBtn" class="flex items-center gap-space-xs px-4 py-2.5 rounded-xl bg-primary text-on-primary font-label-md text-label-md shadow-sm hover:bg-surface-tint transition-all" type="button"><span class="material-symbols-outlined text-[20px]">add</span>Tambah Tugas</button>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-space-md">
      <div class="p-space-lg rounded-xl bg-surface-container-lowest shadow-sm flex items-center justify-between"><div><span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Total Tugas Terdaftar</span><span id="metricTotal" class="block font-headline-xl text-headline-xl text-on-surface font-bold mt-1">12</span><span class="font-body-sm text-body-sm text-on-surface-variant">8 divisi berpartisipasi</span></div><div class="w-12 h-12 rounded-xl bg-surface-container-low flex items-center justify-center text-primary"><span class="material-symbols-outlined text-headline-md">task_alt</span></div></div>
      <div class="p-space-lg rounded-xl bg-surface-container-lowest shadow-sm flex items-center justify-between"><div><span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Belum Dikerjakan</span><span id="metricTodo" class="block font-headline-xl text-headline-xl text-tertiary font-bold mt-1">4</span><span class="font-body-sm text-body-sm text-on-surface-variant">Prioritas sebelum gladi</span></div><div class="w-12 h-12 rounded-xl bg-surface-container-high flex items-center justify-center text-tertiary"><span class="material-symbols-outlined text-headline-md">schedule</span></div></div>
      <div class="p-space-lg rounded-xl bg-surface-container-lowest shadow-sm flex items-center justify-between"><div><span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Sedang Dikerjakan</span><span id="metricProgress" class="block font-headline-xl text-headline-xl text-primary font-bold mt-1">5</span><span class="font-body-sm text-body-sm text-on-surface-variant">Dalam proses eksekusi</span></div><div class="w-12 h-12 rounded-xl bg-surface-container-high flex items-center justify-center text-primary"><span class="material-symbols-outlined text-headline-md">sync</span></div></div>
      <div class="p-space-lg rounded-xl bg-surface-container-lowest shadow-sm flex items-center justify-between"><div><span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Selesai (Done)</span><div class="flex items-baseline gap-2 mt-1"><span id="metricDone" class="font-headline-xl text-headline-xl text-on-surface font-bold">3</span><span id="metricPercentage" class="font-label-md text-label-md text-primary font-bold">25% Rampung</span></div><div class="w-36 h-1.5 rounded-full bg-surface-container mt-2 overflow-hidden"><div id="metricBar" class="h-full bg-primary rounded-full" style="width:25%"></div></div></div><div class="w-12 h-12 rounded-xl bg-secondary-fixed flex items-center justify-center text-on-secondary-fixed"><span class="material-symbols-outlined text-headline-md">verified</span></div></div>
    </div>
  </section>

  <section class="grid grid-cols-1 lg:grid-cols-3 gap-space-lg items-start">
    {columns.map((column) => (
      <div class="flex flex-col rounded-xl bg-surface-container-low p-space-sm shadow-sm">
        <div class="flex items-center justify-between p-space-sm bg-surface-container-lowest rounded-lg mb-space-sm shadow-sm"><div class="flex items-center gap-2"><div class={`w-7 h-7 rounded-lg bg-surface-container flex items-center justify-center ${column.tone}`}><span class="material-symbols-outlined text-[18px]">{column.icon}</span></div><h2 class="font-title-sm text-title-sm text-on-surface font-bold">{column.title}</h2><span id={`count-${column.id}`} class="px-2 py-0.5 rounded-full bg-surface-container-high text-on-surface-variant font-label-sm text-label-sm">{column.items.length}</span></div><span class="material-symbols-outlined text-body-md text-on-surface-variant">more_horiz</span></div>
        <div class="kanban-dropzone flex flex-col gap-space-sm min-h-[460px] p-1 rounded-lg" data-status={column.id}>
          {column.items.map((item, index) => <div class="kanban-card group cursor-grab active:cursor-grabbing p-space-md rounded-xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-all select-none" data-division={item[0]} draggable="true" id={`${column.id}-${index}`}>
            <div class="flex items-center justify-between mb-2"><span class="px-2.5 py-0.5 rounded-full bg-surface-container-high text-primary font-label-sm text-label-sm">{item[0]}</span><button class="delete-card opacity-0 group-hover:opacity-100 text-on-surface-variant hover:text-error" title="Hapus" type="button"><span class="material-symbols-outlined text-[16px]">delete</span></button></div>
            <h3 class={`font-title-sm text-title-sm text-on-surface font-semibold leading-snug ${column.id === 'done' ? 'line-through text-on-surface-variant' : ''}`}>{item[1]}</h3>
            <div class="mt-3"><div class="flex items-center justify-between text-on-surface-variant font-label-sm text-label-sm mb-1"><span class="flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">checklist</span>Subtask</span><span>{item[2]}</span></div><div class="w-full h-1.5 rounded-full bg-surface-container overflow-hidden"><div class="h-full bg-primary rounded-full" style={`width:${Math.round((Number(item[2].split('/')[0]) / Number(item[2].split('/')[1])) * 100)}%`}></div></div></div>
            <div class="flex items-center justify-between mt-space-md pt-space-xs"><div class="flex items-center gap-2"><div class="w-6 h-6 rounded-full bg-surface-container-high text-primary font-label-sm text-label-sm flex items-center justify-center font-bold">{item[3]}</div><span class="font-body-sm text-body-sm text-on-surface truncate max-w-[100px]">{item[4]}</span></div><span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-surface-container text-on-surface-variant font-label-sm text-label-sm"><span class="material-symbols-outlined text-[13px]">event</span>{item[5]}</span></div>
          </div>)}
        </div>
        <button class="quick-add mt-space-sm w-full py-2.5 px-space-md rounded-xl bg-surface-container hover:bg-surface-container-high text-primary font-label-md text-label-md flex items-center justify-center gap-1" data-status={column.id} type="button"><span class="material-symbols-outlined text-[18px]">add</span>Tambah Kartu</button>
      </div>
    ))}
  </section>
</div>

<div id="taskModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/40 backdrop-blur-sm p-4"><form id="createTaskForm" class="w-full max-w-lg rounded-xl bg-surface-container-lowest p-space-lg shadow-xl"><div class="flex items-center justify-between mb-space-md"><div><h3 class="font-title-sm text-title-sm font-bold">Tambah Tugas Baru</h3><p class="font-body-sm text-body-sm text-on-surface-variant">Buat tiket penugasan panitia Takumi Festival</p></div><button id="closeModalBtn" class="material-symbols-outlined" type="button">close</button></div><div class="flex flex-col gap-space-md"><input id="taskTitle" class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface" placeholder="Judul tugas" required /><div class="grid grid-cols-2 gap-space-md"><select id="taskDivision" class="px-3.5 py-2.5 rounded-lg bg-surface-container-low" required><option value="" disabled selected>Pilih divisi</option><option>Acara</option><option>Perlengkapan</option><option>Tenant</option><option>Sponsor</option><option>Publikasi</option><option>Logistik</option><option>Keamanan</option><option>Lomba</option><option>Humas</option><option>Desain</option></select><select id="taskAssignee" class="px-3.5 py-2.5 rounded-lg bg-surface-container-low" required><option value="" disabled selected>Pilih penanggung jawab</option><option value="Amalia Putri">Amalia Putri — Koordinator Utama</option><option value="Andi Pratama">Andi Pratama — Divisi Perlengkapan</option><option value="Salsa Putri">Salsa Putri — Divisi Sponsor</option><option value="Nadia Aulia">Nadia Aulia — Divisi Publikasi</option><option value="Rania Anindya">Rania Anindya — Divisi Tenant</option><option value="Dimas Saputra">Dimas Saputra — Divisi Acara</option><option value="Mira Fadila">Mira Fadila — Divisi Logistik</option><option value="Bagas Fikri">Bagas Fikri — Divisi Keamanan</option></select></div><select id="taskColumn" class="px-3.5 py-2.5 rounded-lg bg-surface-container-low"><option value="todo">Belum Dikerjakan</option><option value="in-progress">Sedang Dikerjakan</option><option value="done">Selesai</option></select><div class="flex justify-end gap-space-sm"><button id="cancelModalBtn" class="px-4 py-2.5 rounded-lg bg-surface-container" type="button">Batal</button><button class="px-5 py-2.5 rounded-lg bg-primary text-on-primary" type="submit">Simpan Tugas</button></div></div></form></div>

<script>
  let draggedCard = null;
  const modal = document.getElementById('taskModal');
  const form = document.getElementById('createTaskForm');
  const openModal = (status = 'todo') => { document.getElementById('taskColumn').value = status; modal.classList.remove('hidden'); modal.classList.add('flex'); document.getElementById('taskTitle').focus(); };
  const closeModal = () => { modal.classList.add('hidden'); modal.classList.remove('flex'); form.reset(); };
  const updateCounters = () => {
    const todo = document.querySelectorAll('[data-status="todo"] .kanban-card').length;
    const progress = document.querySelectorAll('[data-status="in-progress"] .kanban-card').length;
    const done = document.querySelectorAll('[data-status="done"] .kanban-card').length;
    const total = todo + progress + done;
    [['todo', todo], ['in-progress', progress], ['done', done]].forEach(([id, count]) => document.getElementById(`count-${id}`).textContent = count);
    document.getElementById('metricTotal').textContent = total; document.getElementById('metricTodo').textContent = todo; document.getElementById('metricProgress').textContent = progress; document.getElementById('metricDone').textContent = done;
    const percent = total ? Math.round(done / total * 100) : 0; document.getElementById('metricPercentage').textContent = `${percent}% Rampung`; document.getElementById('metricBar').style.width = `${percent}%`;
  };
  const bindCard = (card) => { card.addEventListener('dragstart', () => { draggedCard = card; card.classList.add('opacity-40'); }); card.addEventListener('dragend', () => card.classList.remove('opacity-40')); card.querySelector('.delete-card')?.addEventListener('click', () => { card.remove(); updateCounters(); }); };
  document.querySelectorAll('.kanban-card').forEach(bindCard);
  document.querySelectorAll('.kanban-dropzone').forEach(zone => { zone.addEventListener('dragover', event => { event.preventDefault(); zone.classList.add('bg-surface-container-high', 'outline', 'outline-primary'); }); zone.addEventListener('dragleave', () => zone.classList.remove('bg-surface-container-high', 'outline', 'outline-primary')); zone.addEventListener('drop', event => { event.preventDefault(); zone.classList.remove('bg-surface-container-high', 'outline', 'outline-primary'); if (!draggedCard) return; zone.append(draggedCard); draggedCard.querySelector('h3').classList.toggle('line-through', zone.dataset.status === 'done'); draggedCard = null; updateCounters(); }); });
  document.getElementById('openModalBtn').addEventListener('click', () => openModal()); document.querySelectorAll('.quick-add').forEach(button => button.addEventListener('click', () => openModal(button.dataset.status))); document.getElementById('closeModalBtn').addEventListener('click', closeModal); document.getElementById('cancelModalBtn').addEventListener('click', closeModal);
  form.addEventListener('submit', event => { event.preventDefault(); const title = document.getElementById('taskTitle').value; const division = document.getElementById('taskDivision').value; const assignee = document.getElementById('taskAssignee').value; const status = document.getElementById('taskColumn').value; const initials = assignee.split(' ').map(word => word[0]).join('').slice(0, 2).toUpperCase(); const card = document.createElement('div'); card.draggable = true; card.className = 'kanban-card group cursor-grab active:cursor-grabbing p-space-md rounded-xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-all select-none'; card.innerHTML = `<div class="flex items-center justify-between mb-2"><span class="px-2.5 py-0.5 rounded-full bg-surface-container-high text-primary font-label-sm text-label-sm">${division}</span><button class="delete-card text-on-surface-variant hover:text-error" type="button"><span class="material-symbols-outlined text-[16px]">delete</span></button></div><h3 class="font-title-sm text-title-sm text-on-surface font-semibold leading-snug ${status === 'done' ? 'line-through text-on-surface-variant' : ''}">${title}</h3><div class="flex items-center gap-2 mt-space-md"><div class="w-6 h-6 rounded-full bg-surface-container-high text-primary font-label-sm flex items-center justify-center font-bold">${initials}</div><span class="font-body-sm text-body-sm">${assignee}</span></div>`; document.querySelector(`[data-status="${status}"]`).prepend(card); bindCard(card); closeModal(); updateCounters(); });
  document.getElementById('filterBtn').addEventListener('click', () => showToast('Penyaringan multi-divisi aktif.', 'info'));
  updateCounters();
</script>
