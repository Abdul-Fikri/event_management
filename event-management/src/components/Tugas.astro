<!-- ==================== SCRIPT LOGIC ==================== -->
<script is:inline>
  // Helper Toast Notification
  function showToast(message, type = 'success') {
    const container = document.getElementById('toast-container');
    if (!container) return;

    const toast = document.createElement('div');
    const isError = type === 'error';
    const bgClass = isError ? 'bg-error text-on-error' : 'bg-inverse-surface text-inverse-on-surface';
    const icon = isError ? 'error' : 'check_circle';

    toast.className = `flex items-center gap-space-xs px-space-md py-3 rounded-xl shadow-lg font-body-sm text-body-sm pointer-events-auto transition-all duration-300 transform translate-y-4 opacity-0 ${bgClass}`;
    toast.innerHTML = `
      <span class="material-symbols-outlined text-body-lg">${icon}</span>
      <span>${message}</span>
    `;

    container.appendChild(toast);
    
    // Animate in
    requestAnimationFrame(() => {
      toast.classList.remove('translate-y-4', 'opacity-0');
    });

    // Auto dismiss
    setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-2');
      setTimeout(() => toast.remove(), 300);
    }, 3200);
  }

  function openExportToast() {
    showToast('Mengekspor 42 data penugasan ke format CSV/Excel...');
  }

  // Filter Table Functions
  function filterTasks() {
    const searchVal = document.getElementById('taskSearchInput').value.toLowerCase().trim();
    const statusVal = document.getElementById('statusFilterSelect').value;
    const divisiVal = document.getElementById('divisiFilterSelect').value;
    const rows = document.querySelectorAll('#tableBody tr');
    const clearBtn = document.getElementById('clearSearchBtn');

    if (searchVal.length > 0) {
      clearBtn.classList.remove('hidden');
    } else {
      clearBtn.classList.add('hidden');
    }

    let visibleCount = 0;

    rows.forEach(row => {
      const rowText = row.innerText.toLowerCase();
      const rowStatus = row.getAttribute('data-status') || '';
      const rowDivisi = row.getAttribute('data-divisi') || '';

      const matchSearch = searchVal === '' || rowText.includes(searchVal);
      const matchStatus = statusVal === 'all' || rowStatus === statusVal;
      const matchDivisi = divisiVal === 'all' || rowDivisi.includes(divisiVal);

      if (matchSearch && matchStatus && matchDivisi) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
      }
    });

    // Handle Empty State
    const emptyState = document.getElementById('tableEmptyState');
    const tableHeader = document.querySelector('#tasksTable thead');
    const showingCount = document.getElementById('showingCountText');
    const badgeResult = document.getElementById('badgeResultCount');

    if (visibleCount === 0) {
      emptyState.classList.remove('hidden');
      emptyState.classList.add('flex');
      if (tableHeader) tableHeader.style.display = 'none';
    } else {
      emptyState.classList.add('hidden');
      emptyState.classList.remove('flex');
      if (tableHeader) tableHeader.style.display = '';
    }

    showingCount.innerText = visibleCount === 0 ? '0' : `1-${visibleCount}`;
    badgeResult.innerText = `${visibleCount} Ditampilkan`;
  }

  function clearSearch() {
    document.getElementById('taskSearchInput').value = '';
    filterTasks();
  }

  function resetFilters() {
    document.getElementById('taskSearchInput').value = '';
    document.getElementById('statusFilterSelect').value = 'all';
    document.getElementById('divisiFilterSelect').value = 'all';
    filterTasks();
    showToast('Filter tugas telah diatur ulang.');
  }

  // Modal Tambah / Edit
  function toggleTaskModal(isOpen) {
    const modal = document.getElementById('taskModal');
    if (isOpen) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    } else {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
      resetTaskForm();
    }
  }

  function resetTaskForm() {
    document.getElementById('taskForm').reset();
    document.getElementById('editTaskId').value = '';
    document.getElementById('taskModalTitle').innerText = 'Tambah Tugas Baru';
    document.getElementById('modalHeaderIcon').innerText = 'add_task';
  }

  function editTaskModal(id, title, pic, deadline, status) {
    document.getElementById('editTaskId').value = id;
    document.getElementById('taskModalTitle').innerText = `Edit Tugas (${id})`;
    document.getElementById('modalHeaderIcon').innerText = 'edit_note';
    document.getElementById('inputNamaTugas').value = title;
    document.getElementById('inputDeadline').value = deadline;

    // Check status radio
    const radios = document.getElementsByName('taskStatusRadio');
    radios.forEach(r => {
      if (r.value === status) r.checked = true;
    });

    // Select pic if matching
    const selectPic = document.getElementById('selectPanitia');
    for (let i = 0; i < selectPic.options.length; i++) {
      if (selectPic.options[i].text.includes(pic)) {
        selectPic.selectedIndex = i;
        break;
      }
    }

    toggleTaskModal(true);
  }

  function handleTaskSubmit(event) {
    event.preventDefault();
    const editId = document.getElementById('editTaskId').value;
    const taskTitle = document.getElementById('inputNamaTugas').value;
    
    toggleTaskModal(false);
    if (editId) {
      showToast(`Tugas ${editId} "${taskTitle}" berhasil diperbarui!`);
    } else {
      showToast(`Tugas baru "${taskTitle}" berhasil ditambahkan ke jadwal!`);
    }
  }

  // Modal Detail
  function showTaskDetail(id, title, pic, divisi, deadline, status, notes) {
    document.getElementById('detailTaskId').innerText = id;
    document.getElementById('detailTaskName').innerText = title;
    document.getElementById('detailTaskPic').innerText = pic;
    document.getElementById('detailTaskDiv').innerText = divisi;
    document.getElementById('detailTaskDeadline').innerText = deadline;
    document.getElementById('detailTaskNotes').innerText = notes;

    const badgeEl = document.getElementById('detailTaskBadge');
    badgeEl.innerText = status;
    badgeEl.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full font-label-sm text-label-sm font-semibold ';

    if (status === 'Selesai') {
      badgeEl.className += 'bg-[#DCFCE7] text-[#166534]';
    } else if (status === 'Dalam Proses') {
      badgeEl.className += 'bg-[#E6F3FC] text-primary';
    } else {
      badgeEl.className += 'bg-surface-container text-tertiary';
    }

    toggleDetailModal(true);
  }

  function toggleDetailModal(isOpen) {
    const modal = document.getElementById('taskDetailModal');
    if (isOpen) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    } else {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    }
  }

  // Delete Prompt
  let taskPendingDelete = null;

  function promptDelete(id, name) {
    taskPendingDelete = id;
    document.getElementById('deleteModalMessage').innerText = `Hapus pendelegasian [${id}] "${name}" dari sistem panitia?`;
    toggleDeleteModal(true);
  }

  function toggleDeleteModal(isOpen) {
    const modal = document.getElementById('deleteConfirmModal');
    if (isOpen) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    } else {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
      taskPendingDelete = null;
    }
  }

  document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
    if (taskPendingDelete) {
      const deletedId = taskPendingDelete;
      toggleDeleteModal(false);
      showToast(`Tugas ${deletedId} telah berhasil dihapus.`, 'error');
    }
  });

  // Close modals on Esc key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      toggleTaskModal(false);
      toggleDetailModal(false);
      toggleDeleteModal(false);
    }
  });
</script>