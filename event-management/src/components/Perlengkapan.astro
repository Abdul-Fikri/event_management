<select class="w-full appearance-none px-3.5 py-2.5 rounded-lg bg-surface-container-lowest border border-outline-variant/60 text-on-surface font-body-md text-body-md focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all cursor-pointer" id="input-status">
<option value="Tersedia">Tersedia</option>
