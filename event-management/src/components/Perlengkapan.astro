<div class="pt-space-md flex items-center justify-end gap-space-sm">
<button class="px-space-md py-2.5 rounded-lg bg-surface-container-low text-on-surface font-title-sm text-body-md hover:bg-surface-container transition-colors" id="btn-cancel-modal" type="button">
            Batal
          </button>
<button class="px-space-lg py-2.5 rounded-lg bg-primary text-on-primary font-title-sm text-body-md shadow-md hover:bg-primary/95 transition-all" type="submit">
            Simpan Perlengkapan
          </button>
