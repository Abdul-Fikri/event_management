<!-- DIALOG: Konfirmasi Hapus Data -->
<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-on-background/40 backdrop-blur-sm hidden opacity-0 transition-opacity duration-200" id="dialog-delete">
<div class="relative w-full max-w-md bg-surface-container-lowest rounded-2xl p-space-lg shadow-xl text-center transform scale-95 transition-transform duration-200" id="dialog-content">
<div class="w-14 h-14 mx-auto rounded-full bg-error-container/60 text-error flex items-center justify-center mb-space-md">
<span class="material-symbols-outlined text-headline-lg">delete_forever</span>
</div>
<h3 class="font-title-sm text-headline-md text-on-surface font-bold">Hapus Data Perlengkapan?</h3>
<p class="font-body-md text-body-md text-on-surface-variant mt-2" id="delete-dialog-text">
        Tindakan ini tidak dapat dibatalkan. Data aset barang yang dihapus akan dikeluarkan dari daftar inventaris festival.
      </p>
<div class="mt-space-lg flex items-center justify-center gap-space-sm">
<button class="flex-1 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-title-sm text-body-md hover:bg-surface-container transition-colors" id="btn-cancel-delete" type="button">
          Batal
        </button>
<button class="flex-1 py-2.5 rounded-lg bg-error text-on-error font-title-sm text-body-md hover:bg-error/90 shadow-sm transition-colors" id="btn-confirm-delete" type="button">
          Ya, Hapus
        </button>
</div>
</div>
</div>
</div>
<script is:inline>
  (function () {
    // Elements
    const modal = document.getElementById('modal-equipment');
    const modalContent = document.getElementById('modal-content');
    const openModalBtn = document.getElementById('btn-open-modal');
    const closeModalBtn = document.getElementById('btn-close-modal');
    const cancelModalBtn = document.getElementById('btn-cancel-modal');
    const formEquipment = document.getElementById('form-equipment');
    const modalTitle = document.getElementById('modal-title');
    const formBarangId = document.getElementById('form-barang-id');

    const searchInput = document.getElementById('table-search-input');
    const filterKondisi = document.getElementById('filter-kondisi');
    const filterStatus = document.getElementById('filter-status');
    const resetFilterBtn = document.getElementById('btn-reset-filter');
    const emptyResetBtn = document.getElementById('btn-empty-reset');
    const emptyState = document.getElementById('table-empty-state');
    const showingCount = document.getElementById('showing-count');

    const dialogDelete = document.getElementById('dialog-delete');
    const dialogContent = document.getElementById('dialog-content');
    const cancelDeleteBtn = document.getElementById('btn-cancel-delete');
    const confirmDeleteBtn = document.getElementById('btn-confirm-delete');
    const deleteDialogText = document.getElementById('delete-dialog-text');
    const btnExport = document.getElementById('btn-export-logistik');

    let rowToDelete = null;

    // Toast notification utility
    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      if (!container) return;

      const toast = document.createElement('div');
      toast.className = `flex items-center gap-2.5 px-4 py-3 rounded-xl shadow-lg border border-outline-variant/30 text-on-surface bg-surface-container-lowest pointer-events-auto transform transition-all duration-300 translate-y-2 opacity-0`;

      let icon = 'check_circle';
      let iconColor = 'text-primary';
      if (type === 'error') {
        icon = 'error';
        iconColor = 'text-error';
      } else if (type === 'info') {
        icon = 'info';
        iconColor = 'text-secondary';
      }

      toast.innerHTML = `
        <span class="material-symbols-outlined ${iconColor} text-body-lg">${icon}</span>
        <span class="font-body-md text-body-md font-medium">${message}</span>
      `;

      container.appendChild(toast);

      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      });

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    // Modal Opening & Closing
    function openModal(isEdit = false, rowData = null) {
      if (isEdit && rowData) {
        modalTitle.textContent = 'Edit Data Perlengkapan';
        formBarangId.value = rowData.id;
        document.getElementById('input-nama-barang').value = rowData.name;
        
        // Parse Qty & Unit
        const parts = rowData.qty.split(' ');
        document.getElementById('input-jumlah').value = parts[0] || '1';
        if (parts[1]) document.getElementById('input-satuan').value = parts[1];

        document.getElementById('input-kondisi').value = rowData.kondisi;
        document.getElementById('input-status').value = rowData.status;
        document.getElementById('input-lokasi').value = rowData.location;
        document.getElementById('input-pic').value = rowData.pic;
      } else {
        modalTitle.textContent = 'Tambah Data Perlengkapan';
        formEquipment.reset();
        formBarangId.value = '';
      }

      modal.classList.remove('hidden');
      setTimeout(() => {
        modal.classList.remove('opacity-0');
        modalContent.classList.remove('scale-95');
      }, 10);
    }

    function closeModal() {
      modal.classList.add('opacity-0');
      modalContent.classList.add('scale-95');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 200);
    }

    openModalBtn.addEventListener('click', () => openModal(false));
    closeModalBtn.addEventListener('click', closeModal);
    cancelModalBtn.addEventListener('click', closeModal);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // Form Submission
    formEquipment.addEventListener('submit', (e) => {
      e.preventDefault();
      const isEdit = Boolean(formBarangId.value);
      const barangName = document.getElementById('input-nama-barang').value;

      closeModal();
      if (isEdit) {
        showToast(`Data logistik "${barangName}" berhasil diperbarui.`);
      } else {
        showToast(`Perlengkapan baru "${barangName}" sukses ditambahkan.`);
      }
    });

    // Filtering & Search Logic
    function applyFilters() {
      const query = (searchInput.value || '').toLowerCase().trim();
      const condVal = filterKondisi.value;
      const statusVal = filterStatus.value;
      const rows = document.querySelectorAll('#table-body tr');
      let visibleCount = 0;

      rows.forEach((row) => {
        const rowName = (row.dataset.name || '').toLowerCase();
        const rowLoc = (row.dataset.location || '').toLowerCase();
        const rowPic = (row.dataset.pic || '').toLowerCase();
        const rowId = (row.dataset.id || '').toLowerCase();
        const rowCond = row.dataset.kondisi || '';
        const rowStat = row.dataset.status || '';

        const matchesQuery = !query || 
          rowName.includes(query) || 
          rowLoc.includes(query) || 
          rowPic.includes(query) || 
          rowId.includes(query);

        const matchesCond = (condVal === 'ALL') || (rowCond === condVal);
        const matchesStatus = (statusVal === 'ALL') || (rowStat === statusVal);

        if (matchesQuery && matchesCond && matchesStatus) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      showingCount.textContent = visibleCount;

      if (visibleCount === 0) {
        emptyState.classList.remove('hidden');
      } else {
        emptyState.classList.add('hidden');
      }
    }

    searchInput.addEventListener('input', applyFilters);
    filterKondisi.addEventListener('change', applyFilters);
    filterStatus.addEventListener('change', applyFilters);

    function resetAllFilters() {
      searchInput.value = '';
      filterKondisi.value = 'ALL';
      filterStatus.value = 'ALL';
      applyFilters();
      showToast('Filter telah disetel ulang.', 'info');
    }

    resetFilterBtn.addEventListener('click', resetAllFilters);
    emptyResetBtn.addEventListener('click', resetAllFilters);

    // Edit and Delete Delegations
    document.getElementById('table-body').addEventListener('click', (e) => {
      const editBtn = e.target.closest('.btn-edit');
      const deleteBtn = e.target.closest('.btn-delete');
      const row = e.target.closest('tr');

      if (!row) return;

      if (editBtn) {
        const data = {
          id: row.dataset.id,
          name: row.dataset.name,
          qty: row.dataset.qty,
          kondisi: row.dataset.kondisi,
          status: row.dataset.status,
          location: row.dataset.location,
          pic: row.dataset.pic
        };
        openModal(true, data);
      } else if (deleteBtn) {
        rowToDelete = row;
        deleteDialogText.textContent = `Apakah Anda yakin ingin menghapus data perlengkapan "${row.dataset.name}" (${row.dataset.id}) dari database?`;
        dialogDelete.classList.remove('hidden');
        setTimeout(() => {
          dialogDelete.classList.remove('opacity-0');
          dialogContent.classList.remove('scale-95');
        }, 10);
      }
    });

    // Delete Dialog
    function closeDeleteDialog() {
      dialogDelete.classList.add('opacity-0');
      dialogContent.classList.add('scale-95');
      setTimeout(() => {
        dialogDelete.classList.add('hidden');
        rowToDelete = null;
      }, 200);
    }

    cancelDeleteBtn.addEventListener('click', closeDeleteDialog);
    dialogDelete.addEventListener('click', (e) => {
      if (e.target === dialogDelete) closeDeleteDialog();
    });

    confirmDeleteBtn.addEventListener('click', () => {
      if (rowToDelete) {
        const itemName = rowToDelete.dataset.name;
        rowToDelete.remove();
        applyFilters();
        closeDeleteDialog();
        showToast(`Item "${itemName}" berhasil dihapus dari inventaris.`, 'error');
      }
    });

    // Export Button Toast
    btnExport.addEventListener('click', () => {
      showToast('Mengunduh Berkas Logistik (XLSX)...', 'info');
    });

  })();
</script>