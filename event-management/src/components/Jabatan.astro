<input class="w-full px-3.5 py-2.5 bg-surface-container-lowest text-on-surface font-body-md text-body-md rounded-xl shadow-[0_1px_3px_rgba(51,65,85,0.04)] focus:outline-none focus:ring-2 focus:ring-primary-container transition-all placeholder:text-outline" id="namaJabatan" placeholder="Contoh: Koordinator Lapangan" required="" type="text"/>
<span class="font-body-sm text-body-sm text-outline mt-1 block">Tuliskan nama resmi jabatan yang akan dicantumkan di SK kepanitiaan.</span>
</div>
<!-- Input: Tingkat Hierarki -->
<div>
<label class="block font-label-md text-label-md text-on-surface mb-1.5" for="levelHierarki">
            Level Hierarki <span class="text-error">*</span>
</label>
<div class="relative">
<select class="w-full appearance-none px-3.5 py-2.5 bg-surface-container-lowest text-on-surface font-body-md text-body-md rounded-xl shadow-[0_1px_3px_rgba(51,65,85,0.04)] focus:outline-none focus:ring-2 focus:ring-primary-container transition-all cursor-pointer" id="levelHierarki" required="">
<option disabled="" selected="" value="">Pilih Tingkatan Hierarki</option>
<option value="pimpinan">Tingkat Pimpinan (Level 1)</option>
<option value="bph">Badan Pengurus Harian / BPH (Level 2)</option>
<option value="bidang">Kepala Bidang / Koordinator Divisi (Level 3)</option>
<option value="pelaksana">Pelaksana Teknis / Anggota Divisi (Level 4)</option>
</select>
<span class="material-symbols-outlined text-outline absolute right-3 top-2.5 pointer-events-none text-body-lg">expand_more</span>
</div>
<span class="font-body-sm text-body-sm text-outline mt-1 block">Hierarki menentukan garis instruksi dan kewenangan otorisasi dana.</span>
</div>
<!-- Input: Deskripsi Wewenang -->
<div>
<label class="block font-label-md text-label-md text-on-surface mb-1.5" for="deskripsiJabatan">
            Deskripsi Ringkas Wewenang <span class="text-error">*</span>
</label>
<textarea class="w-full px-3.5 py-2.5 bg-surface-container-lowest text-on-surface font-body-md text-body-md rounded-xl shadow-[0_1px_3px_rgba(51,65,85,0.04)] focus:outline-none focus:ring-2 focus:ring-primary-container transition-all placeholder:text-outline resize-none" id="deskripsiJabatan" placeholder="Jelaskan cakupan wewenang, batas tanggung jawab serta tugas utama..." required="" rows="3"></textarea>
</div>
<!-- Modal Footer Buttons -->
<div class="pt-space-sm flex items-center justify-end gap-space-sm">
<button class="px-4 py-2 bg-surface-container-low text-on-surface font-title-sm text-label-md rounded-xl hover:bg-surface-container transition-colors cursor-pointer" id="btnCancelModal" type="button">
            Batal
          </button>
<button class="flex items-center gap-1.5 px-5 py-2 bg-primary text-on-primary font-title-sm text-label-md rounded-xl shadow-[0_4px_12px_rgba(20,100,142,0.24)] hover:bg-on-primary-fixed-variant transition-all cursor-pointer active:scale-95" type="submit">
<span class="material-symbols-outlined text-body-md">check</span>
<span>Simpan Jabatan</span>
</button>
</div>
</form>
</div>
</div>
<!-- MODAL: Konfirmasi Hapus Data -->
<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/30 backdrop-blur-sm hidden opacity-0 transition-opacity duration-200" id="modalDelete">
<div class="bg-surface-container-lowest w-full max-w-sm rounded-2xl shadow-[0_20px_25px_-5px_rgba(51,65,85,0.1)] p-space-lg text-center transform scale-95 transition-transform duration-200" id="modalDeleteCard">
<div class="w-14 h-14 rounded-2xl bg-error-container text-error flex items-center justify-center mx-auto mb-3">
<span class="material-symbols-outlined text-headline-lg">warning</span>
</div>
<h3 class="font-headline-md text-headline-md text-on-surface font-semibold mb-1">Hapus Jabatan?</h3>
<p class="font-body-md text-body-md text-on-surface-variant mb-space-lg">
        Anda akan menghapus data jabatan <span class="font-bold text-on-surface" id="delTargetName"></span> (<span class="font-mono text-outline" id="delTargetId"></span>). Aksi ini tidak dapat dibatalkan.
      </p>
<div class="flex items-center justify-center gap-space-sm">
<button class="w-1/2 py-2.5 bg-surface-container text-on-surface font-title-sm text-label-md rounded-xl hover:bg-surface-container-high transition-colors cursor-pointer" id="btnCancelDelete">
          Batal
        </button>
<button class="w-1/2 py-2.5 bg-error text-on-error font-title-sm text-label-md rounded-xl shadow-[0_4px_12px_rgba(186,26,26,0.2)] hover:brightness-110 active:scale-95 transition-all cursor-pointer" id="btnConfirmDelete">
          Ya, Hapus
        </button>
</div>
</div>
</div>
</div>
<script is:inline>
  (function() {
    // DOM Elements
    const searchInput = document.getElementById('searchInput');
    const clearSearch = document.getElementById('clearSearch');
    const tableBody = document.getElementById('tableBody');
    const tableEmptyState = document.getElementById('tableEmptyState');
    const btnResetFilter = document.getElementById('btnResetFilter');
    const badgeRowCount = document.getElementById('badgeRowCount');

    // Modal Form Elements
    const btnOpenAddModal = document.getElementById('btnOpenAddModal');
    const modalJabatan = document.getElementById('modalJabatan');
    const modalCard = document.getElementById('modalCard');
    const btnCloseModal = document.getElementById('btnCloseModal');
    const btnCancelModal = document.getElementById('btnCancelModal');
    const formJabatan = document.getElementById('formJabatan');
    const modalTitle = document.getElementById('modalTitle');
    const fieldIdJabatan = document.getElementById('fieldIdJabatan');
    const namaJabatan = document.getElementById('namaJabatan');
    const levelHierarki = document.getElementById('levelHierarki');
    const deskripsiJabatan = document.getElementById('deskripsiJabatan');

    // Modal Delete Elements
    const modalDelete = document.getElementById('modalDelete');
    const modalDeleteCard = document.getElementById('modalDeleteCard');
    const btnCancelDelete = document.getElementById('btnCancelDelete');
    const btnConfirmDelete = document.getElementById('btnConfirmDelete');
    const delTargetName = document.getElementById('delTargetName');
    const delTargetId = document.getElementById('delTargetId');

    let rowToDelete = null;

    // Toast helper using the App Shell container #toast-container
    function showToast(message, type = 'success') {
      const toastContainer = document.getElementById('toast-container');
      if (!toastContainer) return;

      const toast = document.createElement('div');
      toast.className = `pointer-events-auto flex items-center gap-space-sm px-4 py-3 rounded-xl shadow-[0_4px_16px_rgba(0,0,0,0.12)] text-body-md font-body-md transition-all duration-300 transform translate-y-4 opacity-0 ${
        type === 'success' 
          ? 'bg-inverse-surface text-inverse-on-surface' 
          : 'bg-error text-on-error'
      }`;
      
      const icon = type === 'success' ? 'check_circle' : 'info';
      toast.innerHTML = `
        <span class="material-symbols-outlined text-primary-fixed">${icon}</span>
        <span>${message}</span>
      `;

      toastContainer.appendChild(toast);

      // Trigger enter animation
      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-4', 'opacity-0');
      });

      // Auto dismiss
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-x-6');
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    // Modal helper functions
    function openModal(modal, card) {
      modal.classList.remove('hidden');
      requestAnimationFrame(() => {
        modal.classList.remove('opacity-0');
        card.classList.remove('scale-95');
        card.classList.add('scale-100');
      });
    }

    function closeModal(modal, card) {
      modal.classList.add('opacity-0');
      card.classList.remove('scale-100');
      card.classList.add('scale-95');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 200);
    }

    // Add New Button Click
    btnOpenAddModal.addEventListener('click', () => {
      formJabatan.reset();
      fieldIdJabatan.value = '';
      modalTitle.textContent = 'Tambah Jabatan Baru';
      openModal(modalJabatan, modalCard);
    });

    btnCloseModal.addEventListener('click', () => closeModal(modalJabatan, modalCard));
    btnCancelModal.addEventListener('click', () => closeModal(modalJabatan, modalCard));

    // Form Submit (Add or Edit)
    formJabatan.addEventListener('submit', (e) => {
      e.preventDefault();
      const isEdit = fieldIdJabatan.value !== '';
      const nameVal = namaJabatan.value.trim();
      const levelVal = levelHierarki.value;
      const descVal = deskripsiJabatan.value.trim();

      if (!nameVal || !levelVal || !descVal) return;

      closeModal(modalJabatan, modalCard);

      if (isEdit) {
        // Update existing row
        const targetRow = document.querySelector(`tr[data-id="${fieldIdJabatan.value}"]`);
        if (targetRow) {
          const titleDiv = targetRow.querySelector('td:nth-child(3) .font-title-sm');
          const descTd = targetRow.querySelector('td:nth-child(6)');
          if (titleDiv) titleDiv.textContent = nameVal;
          if (descTd) descTd.textContent = descVal;
        }
        showToast(`Jabatan ${nameVal} berhasil diperbarui.`);
      } else {
        // Increment count and prepend/append new row
        const newCount = tableBody.querySelectorAll('tr').length + 1;
        const newId = `JBT-0${newCount}`;
        
        let levelLabel = 'Level 4 (Pelaksana Teknis)';
        let levelClass = 'bg-surface-container-low text-on-surface-variant';
        let dotColor = 'bg-outline';

        if (levelVal === 'pimpinan') {
          levelLabel = 'Level 1 (Pimpinan)';
          levelClass = 'bg-surface-container-high text-on-primary-container';
          dotColor = 'bg-primary';
        } else if (levelVal === 'bph') {
          levelLabel = 'Level 2 (BPH)';
          levelClass = 'bg-secondary-container text-on-secondary-fixed';
          dotColor = 'bg-secondary';
        } else if (levelVal === 'bidang') {
          levelLabel = 'Level 3 (Kepala Bidang)';
          levelClass = 'bg-surface-container text-on-surface-variant';
          dotColor = 'bg-tertiary';
        }

        const tr = document.createElement('tr');
        tr.className = 'hover:bg-surface-container-low/40 transition-colors group animate-fade-in';
        tr.setAttribute('data-id', newId);
        tr.setAttribute('data-level', levelVal);
        tr.innerHTML = `
          <td class="py-3.5 px-space-md text-center font-label-sm text-label-sm text-outline">${newCount}</td>
          <td class="py-3.5 px-space-md">
            <span class="font-label-md text-label-md px-2 py-1 rounded bg-surface-container text-primary font-mono">${newId}</span>
          </td>
          <td class="py-3.5 px-space-md">
            <div class="font-title-sm text-title-sm text-on-surface">${nameVal}</div>
            <div class="font-body-sm text-body-sm text-on-surface-variant">Jabatan Tambahan</div>
          </td>
          <td class="py-3.5 px-space-md">
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full ${levelClass} font-label-sm text-label-sm font-semibold">
              <span class="w-1.5 h-1.5 rounded-full ${dotColor}"></span>
              ${levelLabel}
            </span>
          </td>
          <td class="py-3.5 px-space-md text-center">
            <span class="inline-flex items-center justify-center min-w-8 px-2 py-0.5 rounded-full bg-surface-container text-primary font-label-sm text-label-sm font-bold">0 Orang</span>
          </td>
          <td class="py-3.5 px-space-md text-on-surface-variant font-body-sm text-body-sm">
            ${descVal}
          </td>
          <td class="py-3.5 px-space-md text-right">
            <div class="flex items-center justify-end gap-1">
              <button class="btn-edit p-1.5 rounded-lg text-on-surface-variant hover:text-primary hover:bg-surface-container transition-colors" title="Ubah Data">
                <span class="material-symbols-outlined text-body-lg">edit</span>
              </button>
              <button class="btn-delete p-1.5 rounded-lg text-on-surface-variant hover:text-error hover:bg-error-container/40 transition-colors" title="Hapus Data">
                <span class="material-symbols-outlined text-body-lg">delete</span>
              </button>
            </div>
          </td>
        `;
        tableBody.appendChild(tr);
        attachRowEvents(tr);
        badgeRowCount.textContent = `${tableBody.querySelectorAll('tr').length} Record`;
        showToast(`Jabatan baru ${nameVal} (${newId}) berhasil ditambahkan.`);
      }
    });

    // Edit and Delete Event Delegation
    function attachRowEvents(row) {
      const editBtn = row.querySelector('.btn-edit');
      const deleteBtn = row.querySelector('.btn-delete');
      const idVal = row.getAttribute('data-id');
      const titleEl = row.querySelector('td:nth-child(3) .font-title-sm');
      const descEl = row.querySelector('td:nth-child(6)');
      const levelAttr = row.getAttribute('data-level') || 'pelaksana';

      editBtn.addEventListener('click', () => {
        fieldIdJabatan.value = idVal;
        modalTitle.textContent = `Ubah Jabatan (${idVal})`;
        namaJabatan.value = titleEl.textContent.trim();
        levelHierarki.value = levelAttr;
        deskripsiJabatan.value = descEl.textContent.trim();
        openModal(modalJabatan, modalCard);
      });

      deleteBtn.addEventListener('click', () => {
        rowToDelete = row;
        delTargetName.textContent = titleEl.textContent.trim();
        delTargetId.textContent = idVal;
        openModal(modalDelete, modalDeleteCard);
      });
    }

    document.querySelectorAll('#tableBody tr').forEach(attachRowEvents);

    // Confirm Delete
    btnCancelDelete.addEventListener('click', () => {
      closeModal(modalDelete, modalDeleteCard);
      rowToDelete = null;
    });

    btnConfirmDelete.addEventListener('click', () => {
      if (rowToDelete) {
        const idName = rowToDelete.querySelector('td:nth-child(3) .font-title-sm').textContent;
        rowToDelete.remove();
        closeModal(modalDelete, modalDeleteCard);
        showToast(`Jabatan ${idName} telah berhasil dihapus.`, 'error');
        rowToDelete = null;
        updateNumbers();
      }
    });

    function updateNumbers() {
      const rows = tableBody.querySelectorAll('tr');
      badgeRowCount.textContent = `${rows.length} Record`;
      rows.forEach((r, idx) => {
        const numCell = r.querySelector('td:first-child');
        if (numCell) numCell.textContent = idx + 1;
      });
      if (rows.length === 0) {
        tableEmptyState.classList.remove('hidden');
        tableEmptyState.classList.add('flex');
      }
    }

    // Search / Filter Table
    searchInput.addEventListener('input', (e) => {
      const query = e.target.value.toLowerCase().trim();
      clearSearch.classList.toggle('hidden', query === '');

      let visibleCount = 0;
      const rows = tableBody.querySelectorAll('tr');
      rows.forEach(row => {
        const text = row.textContent.toLowerCase();
        const matches = text.includes(query);
        row.style.display = matches ? '' : 'none';
        if (matches) visibleCount++;
      });

      if (visibleCount === 0 && rows.length > 0) {
        tableEmptyState.classList.remove('hidden');
        tableEmptyState.classList.add('flex');
      } else {
        tableEmptyState.classList.add('hidden');
        tableEmptyState.classList.remove('flex');
      }
    });

    clearSearch.addEventListener('click', () => {
      searchInput.value = '';
      searchInput.dispatchEvent(new Event('input'));
      searchInput.focus();
    });

    btnResetFilter.addEventListener('click', () => {
      searchInput.value = '';
      searchInput.dispatchEvent(new Event('input'));
    });

    // Close Modals on click outside
    window.addEventListener('click', (e) => {
      if (e.target === modalJabatan) closeModal(modalJabatan, modalCard);
      if (e.target === modalDelete) closeModal(modalDelete, modalDeleteCard);
    });

    // Keyboard navigation (Esc to close)
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (!modalJabatan.classList.contains('hidden')) closeModal(modalJabatan, modalCard);
        if (!modalDelete.classList.contains('hidden')) closeModal(modalDelete, modalDeleteCard);
      }
    });
  })();
</script>