<script is:inline>
  (function () {
    // DOM Elements
    const searchInput = document.getElementById('search-input');
    const searchClear = document.getElementById('search-clear');
    const filterDivisi = document.getElementById('filter-divisi');
    const filterJabatan = document.getElementById('filter-jabatan');
    const btnResetFilter = document.getElementById('btn-reset-filter');
    const btnClearSearchEmpty = document.getElementById('btn-clear-search-empty');
    const tableBody = document.getElementById('panitia-table-body');
    const tableEmptyState = document.getElementById('table-empty-state');

    // Modals
    const modalPanitia = document.getElementById('modal-panitia');
    const modalPanitiaTitle = document.getElementById('modal-panitia-title');
    const modalPanitiaIcon = document.getElementById('modal-panitia-icon');
    const formPanitia = document.getElementById('form-panitia');
    const btnTambahPanitia = document.getElementById('btn-tambah-panitia');
    const btnModalClose = document.getElementById('btn-modal-close');
    const btnModalCancel = document.getElementById('btn-modal-cancel');
    const inputEditId = document.getElementById('input-edit-id');
    const inputNama = document.getElementById('input-nama');
    const inputKontak = document.getElementById('input-kontak');
    const inputDivisi = document.getElementById('input-divisi');
    const inputJabatan = document.getElementById('input-jabatan');
    const inputCatatan = document.getElementById('input-catatan');
    const inputPanitiaId = document.getElementById('input-panitia-id');

    // Delete Modal
    const modalDelete = document.getElementById('modal-delete');
    const btnCancelDelete = document.getElementById('btn-cancel-delete');
    const btnConfirmDelete = document.getElementById('btn-confirm-delete');
    const deleteTargetId = document.getElementById('delete-target-id');
    const deleteTargetName = document.getElementById('delete-target-name');
    let currentDeleteRow = null;

    // Detail Modal
    const modalDetail = document.getElementById('modal-detail');
    const btnCloseDetail = document.getElementById('btn-close-detail');
    const btnDoneDetail = document.getElementById('btn-done-detail');
    const detailAvatar = document.getElementById('detail-avatar');
    const detailId = document.getElementById('detail-id');
    const detailName = document.getElementById('detail-name');
    const detailDivisi = document.getElementById('detail-divisi');
    const detailJabatan = document.getElementById('detail-jabatan');
    const detailKontak = document.getElementById('detail-kontak');

    // Export Button
    const btnExport = document.getElementById('btn-export');

    // Toast Manager (Injects cleanly into shell #toast-container)
    function showToast(message, type = 'success') {
      const toastContainer = document.getElementById('toast-container');
      if (!toastContainer) return;

      const toast = document.createElement('div');
      toast.className = 'pointer-events-auto flex items-center gap-space-sm px-space-md py-space-sm rounded-xl bg-surface-container-lowest shadow-xl border border-surface-container transition-all transform duration-300 translate-y-4 opacity-0';
      
      const icon = type === 'success' ? 'check_circle' : 'info';
      const iconColor = type === 'success' ? 'text-primary' : 'text-secondary';

      toast.innerHTML = `
        <span class="material-symbols-outlined ${iconColor} text-headline-md">${icon}</span>
        <div class="flex flex-col">
          <span class="font-title-sm text-title-sm text-on-surface font-semibold">Pemberitahuan Sistem</span>
          <span class="font-body-sm text-body-sm text-on-surface-variant">${message}</span>
        </div>
        <button type="button" class="ml-2 text-outline hover:text-on-surface" onclick="this.parentElement.remove()">
          <span class="material-symbols-outlined text-body-md">close</span>
        </button>
      `;

      toastContainer.appendChild(toast);
      // Trigger enter animation
      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-4', 'opacity-0');
      });

      // Auto dismiss after 4 seconds
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 350);
      }, 4000);
    }

    // Filter & Search Logic
    function applyFilters() {
      const query = (searchInput.value || '').toLowerCase().trim();
      const divisiVal = filterDivisi.value;
      const jabatanVal = filterJabatan.value;

      searchClear.classList.toggle('hidden', query.length === 0);

      const rows = tableBody.querySelectorAll('tr');
      let visibleCount = 0;

      rows.forEach(row => {
        const id = (row.dataset.id || '').toLowerCase();
        const name = (row.querySelector('.name-field')?.textContent || '').toLowerCase();
        const contact = (row.querySelector('.contact-field')?.textContent || '').toLowerCase();
        const divisi = (row.querySelector('.divisi-field')?.textContent || '').trim();
        const jabatan = (row.querySelector('.jabatan-field')?.textContent || '').trim();

        const matchQuery = !query || id.includes(query) || name.includes(query) || contact.includes(query) || jabatan.toLowerCase().includes(query);
        const matchDivisi = divisiVal === 'ALL' || divisi.toLowerCase().includes(divisiVal.toLowerCase());
        const matchJabatan = jabatanVal === 'ALL' || jabatan.toLowerCase().includes(jabatanVal.toLowerCase());

        if (matchQuery && matchDivisi && matchJabatan) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      if (visibleCount === 0) {
        tableEmptyState.classList.remove('hidden');
        tableEmptyState.classList.add('flex');
      } else {
        tableEmptyState.classList.add('hidden');
        tableEmptyState.classList.remove('flex');
      }
    }

    searchInput.addEventListener('input', applyFilters);
    filterDivisi.addEventListener('change', applyFilters);
    filterJabatan.addEventListener('change', applyFilters);

    searchClear.addEventListener('click', () => {
      searchInput.value = '';
      applyFilters();
      searchInput.focus();
    });

    btnResetFilter.addEventListener('click', () => {
      searchInput.value = '';
      filterDivisi.value = 'ALL';
      filterJabatan.value = 'ALL';
      applyFilters();
      showToast('Semua filter berhasil disetel ulang.', 'info');
    });

    btnClearSearchEmpty.addEventListener('click', () => {
      searchInput.value = '';
      filterDivisi.value = 'ALL';
      filterJabatan.value = 'ALL';
      applyFilters();
    });

    // Modal Add Open
    btnTambahPanitia.addEventListener('click', () => {
      formPanitia.reset();
      inputEditId.value = '';
      modalPanitiaTitle.textContent = 'Tambah Data Panitia Baru';
      modalPanitiaIcon.textContent = 'person_add';
      
      const count = tableBody.querySelectorAll('tr').length + 1;
      const autoId = `PNT-00${count}`;
      inputPanitiaId.value = `${autoId} (Otomatis)`;

      modalPanitia.classList.remove('hidden');
    });

    // Modal Close
    function closeModalPanitia() {
      modalPanitia.classList.add('hidden');
      formPanitia.reset();
    }

    btnModalClose.addEventListener('click', closeModalPanitia);
    btnModalCancel.addEventListener('click', closeModalPanitia);
    document.getElementById('modal-panitia-backdrop').addEventListener('click', closeModalPanitia);

    // Form Submit (Add or Edit)
    formPanitia.addEventListener('submit', (e) => {
      e.preventDefault();
      const nama = inputNama.value.trim();
      const kontak = inputKontak.value.trim();
      const divisi = inputDivisi.value;
      const jabatan = inputJabatan.value;
      const editId = inputEditId.value;

      if (!nama || !kontak || !divisi || !jabatan) return;

      if (editId) {
        // Edit Existing Row
        const targetRow = tableBody.querySelector(`tr[data-id="${editId}"]`);
        if (targetRow) {
          const nameSpan = targetRow.querySelector('.name-field');
          const contactSpan = targetRow.querySelector('.contact-field span:last-child');
          const divisiSpan = targetRow.querySelector('.divisi-field');
          const jabatanSpan = targetRow.querySelector('.jabatan-field');

          if (nameSpan) nameSpan.textContent = nama;
          if (contactSpan) contactSpan.textContent = kontak;
          if (divisiSpan) divisiSpan.textContent = divisi;
          if (jabatanSpan) jabatanSpan.textContent = jabatan;
        }
        showToast(`Data panitia ${editId} (${nama}) berhasil diperbarui!`, 'success');
      } else {
        // Add New Row
        const totalRows = tableBody.querySelectorAll('tr').length + 1;
        const newId = `PNT-0${totalRows < 10 ? '0' + totalRows : totalRows}`;
        const initials = nama.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() || 'PN';

        const newRow = document.createElement('tr');
        newRow.className = 'hover:bg-surface-container-low/60 transition-colors group';
        newRow.setAttribute('data-id', newId);
        newRow.innerHTML = `
          <td class="py-3.5 px-space-md text-center text-on-surface-variant font-medium">${totalRows}</td>
          <td class="py-3.5 px-space-md">
            <span class="font-label-md text-label-md font-bold text-primary bg-surface-container-high px-2 py-0.5 rounded">${newId}</span>
          </td>
          <td class="py-3.5 px-space-md">
            <div class="flex items-center gap-space-sm">
              <div class="w-8 h-8 rounded-full bg-primary-container text-on-primary flex items-center justify-center font-bold text-label-sm">${initials}</div>
              <div class="flex flex-col min-w-0">
                <span class="font-title-sm text-title-sm text-on-surface font-semibold truncate name-field">${nama}</span>
                <span class="font-body-sm text-body-sm text-on-surface-variant">Personel Terjadwal</span>
              </div>
            </div>
          </td>
          <td class="py-3.5 px-space-md">
            <a href="https://wa.me/${kontak.replace(/[^0-9]/g, '')}" target="_blank" class="inline-flex items-center gap-1 text-primary hover:underline font-label-md text-label-md contact-field">
              <span class="material-symbols-outlined text-body-sm text-primary">chat</span>
              <span>${kontak}</span>
            </a>
          </td>
          <td class="py-3.5 px-space-md">
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-label-sm font-semibold bg-surface-container-high text-primary divisi-field">
              ${divisi}
            </span>
          </td>
          <td class="py-3.5 px-space-md">
            <span class="font-label-md text-label-md text-on-surface font-medium jabatan-field">${jabatan}</span>
          </td>
          <td class="py-3.5 px-space-md">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-label-sm font-semibold bg-surface-container-high text-primary">
              <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
              Aktif
            </span>
          </td>
          <td class="py-3.5 px-space-md text-center">
            <div class="flex items-center justify-center gap-1">
              <button type="button" class="btn-action-detail p-1.5 text-on-surface-variant hover:text-primary hover:bg-surface-container rounded-lg transition-colors" title="Lihat Detail">
                <span class="material-symbols-outlined text-body-lg">visibility</span>
              </button>
              <button type="button" class="btn-action-edit p-1.5 text-on-surface-variant hover:text-primary hover:bg-surface-container rounded-lg transition-colors" title="Edit Data">
                <span class="material-symbols-outlined text-body-lg">edit</span>
              </button>
              <button type="button" class="btn-action-delete p-1.5 text-on-surface-variant hover:text-error hover:bg-error-container/40 rounded-lg transition-colors" title="Hapus Data">
                <span class="material-symbols-outlined text-body-lg">delete</span>
              </button>
            </div>
          </td>
        `;

        tableBody.appendChild(newRow);
        attachRowEvents(newRow);
        showToast('Data panitia baru berhasil disimpan ke sistem!', 'success');
      }

      closeModalPanitia();
      applyFilters();
    });

    // Row Actions Delegator & Binder
    function attachRowEvents(row) {
      // Edit button
      const btnEdit = row.querySelector('.btn-action-edit');
      if (btnEdit) {
        btnEdit.addEventListener('click', () => {
          const rowId = row.dataset.id;
          const name = row.querySelector('.name-field')?.textContent || '';
          const contact = row.querySelector('.contact-field span:last-child')?.textContent || '';
          const divisi = row.querySelector('.divisi-field')?.textContent.trim() || '';
          const jabatan = row.querySelector('.jabatan-field')?.textContent.trim() || '';

          inputEditId.value = rowId;
          inputPanitiaId.value = rowId;
          inputNama.value = name;
          inputKontak.value = contact;
          inputDivisi.value = divisi;
          inputJabatan.value = jabatan;

          modalPanitiaTitle.textContent = `Edit Data Panitia (${rowId})`;
          modalPanitiaIcon.textContent = 'edit_note';
          modalPanitia.classList.remove('hidden');
        });
      }

      // Delete button
      const btnDelete = row.querySelector('.btn-action-delete');
      if (btnDelete) {
        btnDelete.addEventListener('click', () => {
          currentDeleteRow = row;
          const rowId = row.dataset.id;
          const name = row.querySelector('.name-field')?.textContent || '';

          deleteTargetId.textContent = rowId;
          deleteTargetName.textContent = name;
          modalDelete.classList.remove('hidden');
        });
      }

      // Detail button
      const btnDetail = row.querySelector('.btn-action-detail');
      if (btnDetail) {
        btnDetail.addEventListener('click', () => {
          const rowId = row.dataset.id;
          const name = row.querySelector('.name-field')?.textContent || '';
          const contact = row.querySelector('.contact-field span:last-child')?.textContent || '';
          const divisi = row.querySelector('.divisi-field')?.textContent.trim() || '';
          const jabatan = row.querySelector('.jabatan-field')?.textContent.trim() || '';

          detailId.textContent = rowId;
          detailName.textContent = name;
          detailDivisi.textContent = divisi;
          detailJabatan.textContent = jabatan;
          detailKontak.textContent = contact;
          detailAvatar.textContent = name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() || 'PT';

          modalDetail.classList.remove('hidden');
        });
      }
    }

    // Attach to existing rows
    tableBody.querySelectorAll('tr').forEach(attachRowEvents);

    // Delete confirmation handling
    function closeDeleteModal() {
      modalDelete.classList.add('hidden');
      currentDeleteRow = null;
    }

    btnCancelDelete.addEventListener('click', closeDeleteModal);
    document.getElementById('modal-delete-backdrop').addEventListener('click', closeDeleteModal);

    btnConfirmDelete.addEventListener('click', () => {
      if (currentDeleteRow) {
        const id = currentDeleteRow.dataset.id;
        const name = currentDeleteRow.querySelector('.name-field')?.textContent || 'Panitia';
        currentDeleteRow.remove();
        showToast(`Data ${id} (${name}) berhasil dihapus!`, 'success');
        closeDeleteModal();
        applyFilters();
      }
    });

    // Detail Modal Close
    function closeDetailModal() {
      modalDetail.classList.add('hidden');
    }
    btnCloseDetail.addEventListener('click', closeDetailModal);
    btnDoneDetail.addEventListener('click', closeDetailModal);
    document.getElementById('modal-detail-backdrop').addEventListener('click', closeDetailModal);

    // Export Action Micro-feedback
    btnExport.addEventListener('click', () => {
      showToast('Memproses file export: Takumi_Panitia_Manifest_2025.xlsx...', 'info');
      setTimeout(() => {
        showToast('Manifest panitia siap diunduh.', 'success');
      }, 1500);
    });

  })();
</script>