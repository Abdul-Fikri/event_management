<div class="p-space-md rounded-lg bg-surface-container-low space-y-space-xs">
<span class="font-label-md text-label-md font-semibold text-on-surface">Daftar Benefit Tertera dalam Kontrak:</span>
<ul class="space-y-1.5 font-body-md text-body-md text-on-surface-variant pl-4 list-disc" id="detail-benefit-list">
<!-- Dynamic Benefit list -->
</ul>
</div>
<div class="flex items-center justify-between font-label-md text-label-md pt-space-xs">
<span class="text-outline">Penanggung Jawab:</span>
<span class="text-on-surface font-semibold" id="detail-pic">Farah Nabila</span>
</div>
</div>
<div class="px-space-lg py-space-md bg-surface-container-low flex justify-end">
<button class="px-4 py-2 rounded-lg bg-primary text-on-primary font-label-md text-label-md hover:bg-primary/90" id="btn-close-detail-footer" type="button">
          Tutup
        </button>
</div>
</div>
</div>
<!-- MODAL: KONFIRMASI HAPUS DATA -->
<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/40 backdrop-blur-sm hidden opacity-0 transition-opacity duration-200" id="modal-delete">
<div class="bg-surface-container-lowest w-full max-w-md rounded-xl shadow-xl overflow-hidden p-space-lg space-y-space-md animate-in fade-in zoom-in-95 duration-200">
<div class="w-12 h-12 rounded-full bg-error-container text-error flex items-center justify-center">
<span class="material-symbols-outlined text-headline-md">warning</span>
</div>
<div class="space-y-1">
<h3 class="font-headline-md text-headline-md text-on-surface">Hapus Mitra Sponsor?</h3>
<p class="font-body-md text-body-md text-on-surface-variant leading-normal">
          Apakah Anda yakin ingin menghapus data kemitraan <span class="font-semibold text-on-surface" id="delete-sponsor-name"></span>? Tindakan ini akan membatalkan alokasi benefit festival.
        </p>
</div>
<div class="flex items-center justify-end gap-space-sm pt-space-sm">
<button class="px-4 py-2 rounded-lg bg-surface-container-low text-on-surface hover:bg-surface-container-high font-label-md text-label-md transition-colors" id="btn-cancel-delete" type="button">
          Batal
        </button>
<button class="px-4 py-2 rounded-lg bg-error text-on-error hover:bg-error/90 font-label-md text-label-md transition-colors shadow-sm" id="btn-confirm-delete" type="button">
          Ya, Hapus Data
        </button>
</div>
</div>
</div>
</div>
<!-- SCRIPT: INTERACTION & LOGIC -->
<script is:inline>
  (() => {
    // DOM Elements
    const btnOpenAddModal = document.getElementById('btn-open-add-modal');
    const modalSponsor = document.getElementById('modal-sponsor');
    const btnCloseModal = document.getElementById('btn-close-modal');
    const btnCancelModal = document.getElementById('btn-cancel-modal');
    const formSponsor = document.getElementById('form-sponsor');
    const modalTitle = document.getElementById('modal-title');
    
    // Form Inputs
    const inputId = document.getElementById('input-sponsor-id');
    const inputNama = document.getElementById('input-nama-sponsor');
    const selectTier = document.getElementById('select-tier');
    const inputNilai = document.getElementById('input-nilai');
    const inputPicNama = document.getElementById('input-pic-nama');
    const inputPicKontak = document.getElementById('input-pic-kontak');
    const selectPanitia = document.getElementById('select-panitia');
    const textareaBenefit = document.getElementById('textarea-benefit');

    // Delete Modal Elements
    const modalDelete = document.getElementById('modal-delete');
    const btnCancelDelete = document.getElementById('btn-cancel-delete');
    const btnConfirmDelete = document.getElementById('btn-confirm-delete');
    const deleteSponsorNameSpan = document.getElementById('delete-sponsor-name');
    let targetDeleteId = null;

    // Detail Modal Elements
    const modalDetail = document.getElementById('modal-detail');
    const btnCloseDetail = document.getElementById('btn-close-detail');
    const btnCloseDetailFooter = document.getElementById('btn-close-detail-footer');
    const detailNama = document.getElementById('detail-nama');
    const detailTier = document.getElementById('detail-tier');
    const detailBenefitList = document.getElementById('detail-benefit-list');
    const detailPic = document.getElementById('detail-pic');

    // Toast Container (defined in shell as #toast-container)
    const toastContainer = document.getElementById('toast-container');

    // Show Toast Notification
    const showToast = (message, type = 'success') => {
      if (!toastContainer) return;
      const toast = document.createElement('div');
      toast.className = `flex items-center gap-2 px-4 py-3 rounded-lg shadow-lg text-body-md font-body-md pointer-events-auto transform transition-all duration-300 translate-y-2 opacity-0 ${
        type === 'success' ? 'bg-inverse-surface text-inverse-on-surface' : 'bg-error text-on-error'
      }`;
      toast.innerHTML = `
        <span class="material-symbols-outlined text-body-lg text-primary-container">${type === 'success' ? 'check_circle' : 'error'}</span>
        <span>${message}</span>
      `;
      toastContainer.appendChild(toast);
      
      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      });

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    };

    // Modal Visibility Helpers
    const openModal = (modal) => {
      modal.classList.remove('hidden');
      setTimeout(() => {
        modal.classList.remove('opacity-0');
      }, 10);
    };

    const closeModal = (modal) => {
      modal.classList.add('opacity-0');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 200);
    };

    // Open Add Modal
    btnOpenAddModal.addEventListener('click', () => {
      modalTitle.textContent = 'Tambah Mitra Sponsor Baru';
      formSponsor.reset();
      inputId.value = '';
      openModal(modalSponsor);
    });

    // Close Add/Edit Modal
    btnCloseModal.addEventListener('click', () => closeModal(modalSponsor));
    btnCancelModal.addEventListener('click', () => closeModal(modalSponsor));

    // Handle Form Submit (Add or Edit)
    formSponsor.addEventListener('submit', (e) => {
      e.preventDefault();
      const isEdit = Boolean(inputId.value);
      closeModal(modalSponsor);
      showToast(isEdit ? 'Data sponsor berhasil diperbarui!' : 'Sponsor baru berhasil ditambahkan!');
    });

    // Detail Modal Handlers
    document.querySelectorAll('.btn-detail').forEach((btn) => {
      btn.addEventListener('click', () => {
        const row = btn.closest('tr');
        const name = row.querySelector('.font-title-sm').textContent.trim();
        const tier = row.dataset.tier;
        const pic = row.querySelector('td:nth-child(7) span.font-body-md').textContent.trim();
        const badges = row.querySelectorAll('td:nth-child(6) span');

        detailNama.textContent = name;
        detailTier.textContent = tier;
        detailPic.textContent = pic;
        detailBenefitList.innerHTML = '';

        badges.forEach(b => {
          const li = document.createElement('li');
          li.textContent = b.textContent;
          detailBenefitList.appendChild(li);
        });

        openModal(modalDetail);
      });
    });

    btnCloseDetail.addEventListener('click', () => closeModal(modalDetail));
    btnCloseDetailFooter.addEventListener('click', () => closeModal(modalDetail));

    // Edit Button Handlers
    document.querySelectorAll('.btn-edit').forEach((btn) => {
      btn.addEventListener('click', () => {
        const row = btn.closest('tr');
        const id = row.dataset.id;
        const name = row.querySelector('.font-title-sm').textContent.trim();
        const picFull = row.querySelector('td:nth-child(5) .font-semibold').textContent.trim();
        const picContact = row.querySelector('td:nth-child(5) .font-body-sm').textContent.replace(/phone/g, '').trim();

        modalTitle.textContent = `Edit Data Sponsor (${id})`;
        inputId.value = id;
        inputNama.value = name;
        inputPicNama.value = picFull;
        inputPicKontak.value = picContact;
        inputNilai.value = '25.000.000';
        textareaBenefit.value = Array.from(row.querySelectorAll('td:nth-child(6) span')).map(s => s.textContent).join(', ');

        openModal(modalSponsor);
      });
    });

    // Delete Modal Handlers
    document.querySelectorAll('.btn-delete').forEach((btn) => {
      btn.addEventListener('click', () => {
        targetDeleteId = btn.dataset.id;
        deleteSponsorNameSpan.textContent = btn.dataset.name || targetDeleteId;
        openModal(modalDelete);
      });
    });

    btnCancelDelete.addEventListener('click', () => {
      closeModal(modalDelete);
      targetDeleteId = null;
    });

    btnConfirmDelete.addEventListener('click', () => {
      if (targetDeleteId) {
        const row = document.querySelector(`tr[data-id="${targetDeleteId}"]`);
        if (row) row.remove();
        closeModal(modalDelete);
        showToast('Data mitra sponsor telah dihapus dari sistem.', 'error');
        targetDeleteId = null;
      }
    });

    // Export Rekap Sponsorship Button
    document.getElementById('btn-export-rekap').addEventListener('click', () => {
      showToast('Sedang menyiapkan file rekap sponsorship (XLSX)...');
      setTimeout(() => {
        showToast('Rekapitulasi sponsorship berhasil diunduh!');
      }, 1200);
    });

    // Filter by Tier
    const filterPills = document.querySelectorAll('.filter-pill');
    const tableRows = document.querySelectorAll('.sponsor-row');
    const searchInput = document.getElementById('table-search');

    const filterTable = () => {
      const activePill = document.querySelector('.filter-pill.active');
      const tierFilter = activePill ? activePill.dataset.tier : 'ALL';
      const searchVal = searchInput.value.toLowerCase().trim();

      let visibleCount = 0;

      tableRows.forEach(row => {
        const rowText = row.textContent.toLowerCase();
        const rowTier = row.dataset.tier;

        const matchesTier = (tierFilter === 'ALL') || 
                            (tierFilter === 'Partner' && (rowTier.includes('Partner') || rowTier === 'Partner')) ||
                            (rowTier === tierFilter);

        const matchesSearch = rowText.includes(searchVal);

        if (matchesTier && matchesSearch) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      const infoText = document.getElementById('table-info');
      if (infoText) {
        infoText.textContent = `Menampilkan ${visibleCount} dari ${tableRows.length} mitra sponsor`;
      }
    };

    filterPills.forEach(pill => {
      pill.addEventListener('click', () => {
        filterPills.forEach(p => {
          p.classList.remove('active', 'bg-primary', 'text-on-primary', 'shadow-sm');
          p.classList.add('bg-surface-container-low', 'text-on-surface');
        });
        pill.classList.add('active', 'bg-primary', 'text-on-primary', 'shadow-sm');
        pill.classList.remove('bg-surface-container-low', 'text-on-surface');
        filterTable();
      });
    });

    searchInput.addEventListener('input', filterTable);

  })();
</script>