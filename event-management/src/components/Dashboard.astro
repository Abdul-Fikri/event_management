<script is:inline>
  function openQuickNoteModal() {
    const modal = document.getElementById('quickNoteModal');
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
  }

  function closeQuickNoteModal() {
    const modal = document.getElementById('quickNoteModal');
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  }

  function handleQuickNoteSubmit(e) {
    e.preventDefault();
    const title = document.getElementById('noteTitle').value;
    closeQuickNoteModal();
    showToast(`Catatan "${title}" berhasil disimpan ke sistem!`);
    document.getElementById('quickNoteForm').reset();
  }

  function triggerExportReport() {
    showToast("Mengunduh Laporan Ringkas Festival (PDF)...");
  }

  function showToast(message) {
    const container = document.getElementById('toast-container');
    if (!container) return;
    
    const toast = document.createElement('div');
    toast.className = 'px-4 py-3 rounded-xl bg-inverse-surface text-inverse-on-surface shadow-xl flex items-center gap-2 font-label-md text-label-md pointer-events-auto transform transition-all duration-300 translate-y-2 opacity-0';
    toast.innerHTML = `
      <span class="material-symbols-outlined text-primary-fixed-dim text-body-md">check_circle</span>
      <span>${message}</span>
    `;
    container.appendChild(toast);

    requestAnimationFrame(() => {
      toast.classList.remove('translate-y-2', 'opacity-0');
    });

    setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-2');
      setTimeout(() => toast.remove(), 300);
    }, 3200);
  }
</script>