---
interface Props {
  title?: string;
  currentPage?: string;
}

const { title = 'Takumi Festival - Sistem Manajemen Acara', currentPage = 'dashboard' } = Astro.props;

const navItems = [
  { path: 'dashboard', label: 'Dashboard', icon: 'dashboard', href: '/' },
  { path: 'panitia', label: 'Panitia', icon: 'group', href: '/panitia' },
  { path: 'divisi', label: 'Divisi', icon: 'domain', href: '/divisi' },
  { path: 'jabatan', label: 'Jabatan', icon: 'badge', href: '/jabatan' },
  { path: 'rundown', label: 'Rundown', icon: 'schedule', href: '/rundown' },
  { path: 'tugas', label: 'Tugas', icon: 'checklist', href: '/tugas' },
  { path: 'perlengkapan', label: 'Perlengkapan', icon: 'inventory_2', href: '/perlengkapan' },
  { path: 'tenant', label: 'Tenant', icon: 'storefront', href: '/tenant' },
  { path: 'lomba', label: 'Lomba', icon: 'emoji_events', href: '/lomba' },
  { path: 'sponsor', label: 'Sponsor', icon: 'handshake', href: '/sponsor' },
];
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <meta content="web_dashboard" name="shell-type" />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <style is:global>
    @layer base {
      html, body {
        margin: 0;
        padding: 0;
      }
      body {
        overscroll-behavior: none;
      }
      main > :first-child {
        margin-top: 0 !important;
      }
      main > :last-child {
        margin-bottom: 0 !important;
      }
    }
    ::-webkit-scrollbar {
      display: none;
    }
  </style>
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "surface-container-high": "#dde9ff",
            "surface-container": "#e6eeff",
            "inverse-on-surface": "#ebf1ff",
            "on-error-container": "#93000a",
            "tertiary-fixed-dim": "#bbc8d1",
            "on-secondary-fixed": "#001e2c",
            "on-primary": "#ffffff",
            "on-tertiary-container": "#39454c",
            "surface-container-lowest": "#ffffff",
            "inverse-surface": "#233144",
            "outline": "#70787f",
            "inverse-primary": "#8dcefd",
            "on-secondary": "#ffffff",
            "surface-container-low": "#eff4ff",
            "secondary-fixed-dim": "#a8cbe3",
            "on-primary-fixed-variant": "#004c6e",
            "surface-container-highest": "#d5e3fd",
            "on-secondary-fixed-variant": "#274b5e",
            "on-background": "#0d1c2f",
            "secondary-fixed": "#c4e7ff",
            "primary-fixed": "#c9e6ff",
            "on-tertiary-fixed": "#111d23",
            "error": "#ba1a1a",
            "primary": "#14648e",
            "on-error": "#ffffff",
            "primary-fixed-dim": "#8dcefd",
            "tertiary-fixed": "#d7e4ed",
            "error-container": "#ffdad6",
            "primary-container": "#76b7e5",
            "surface-dim": "#ccdbf4",
            "surface": "#f8f9ff",
            "on-surface": "#0d1c2f",
            "on-tertiary-fixed-variant": "#3c4850",
            "outline-variant": "#c0c7cf",
            "on-primary-container": "#004869",
            "surface-tint": "#14648e",
            "surface-bright": "#f8f9ff",
            "tertiary": "#546068",
            "on-secondary-container": "#44677b",
            "secondary-container": "#c0e5fd",
            "tertiary-container": "#a5b2ba",
            "secondary": "#406377",
            "on-tertiary": "#ffffff",
            "surface-variant": "#d5e3fd",
            "background": "#f8f9ff",
            "on-surface-variant": "#40484e",
            "on-primary-fixed": "#001e2f"
          },
          borderRadius: {
            DEFAULT: "0.25rem",
            lg: "0.5rem",
            xl: "0.75rem",
            full: "9999px"
          },
          spacing: {
            "space-sm": "0.5rem",
            "margin-mobile": "1rem",
            "space-xs": "0.25rem",
            "space-xl": "2.5rem",
            "space-md": "1rem",
            gutter: "1.5rem",
            "gutter-mobile": "1rem",
            "space-lg": "1.5rem",
            margin: "2rem"
          },
          fontFamily: {
            "headline-lg-mobile": ["Plus Jakarta Sans"],
            "body-sm": ["Plus Jakarta Sans"],
            "title-sm": ["Plus Jakarta Sans"],
            "body-lg": ["Plus Jakarta Sans"],
            "headline-xl-mobile": ["Plus Jakarta Sans"],
            "label-sm": ["Plus Jakarta Sans"],
            "headline-lg": ["Plus Jakarta Sans"],
            "headline-xl": ["Plus Jakarta Sans"],
            "headline-md": ["Plus Jakarta Sans"],
            "body-md": ["Plus Jakarta Sans"],
            "label-md": ["Plus Jakarta Sans"]
          },
          fontSize: {
            "headline-lg-mobile": ["22px", { lineHeight: "30px", fontWeight: "600" }],
            "body-sm": ["12px", { lineHeight: "18px", fontWeight: "400" }],
            "title-sm": ["16px", { lineHeight: "24px", fontWeight: "600" }],
            "body-lg": ["16px", { lineHeight: "24px", fontWeight: "400" }],
            "headline-xl-mobile": ["28px", { lineHeight: "36px", fontWeight: "700" }],
            "label-sm": ["11px", { lineHeight: "16px", fontWeight: "600" }],
            "headline-lg": ["28px", { lineHeight: "36px", fontWeight: "600" }],
            "headline-xl": ["36px", { lineHeight: "44px", fontWeight: "700" }],
            "headline-md": ["20px", { lineHeight: "28px", fontWeight: "600" }],
            "body-md": ["14px", { lineHeight: "20px", fontWeight: "400" }],
            "label-md": ["13px", { lineHeight: "18px", fontWeight: "600" }]
          }
        }
      }
    }
  </script>
</head>
<body class="bg-surface text-on-surface antialiased">
  <!-- Sidebar -->
  <aside class="fixed left-0 top-0 h-full w-64 bg-surface-container-lowest z-50 flex flex-col shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
    <div class="h-16 px-space-md flex items-center gap-space-sm bg-surface-container-lowest">
      <img alt="Takumi Festival Logo" class="h-8 w-auto object-contain" src="https://lh3.googleusercontent.com/aida/AEtjO1WYtp_Zjeo26PDjEeLCv52JlWqEAJj3dOoW6H_ystgt0TrQL5z_YA9YcOKOp54HAPm6j9xGdtOxwE5Ac5YGLKEuBpwaokJDtjIrDmJPW8_l4KPrfmnQZNowm5vgqe4omjmpJPP26y3Mgv_g6j1ynrLlVCtfjy_hBe3T-SmMyKXuqG9Qv_MSYVbrei93ndtHGcCE2DImxIygX0N9ZrtNcaILdg-6XVwCOQ4wXECNVRYNm7Jno0FS7hkurUc" />
      <div class="flex flex-col min-w-0">
        <span class="font-title-sm text-title-sm text-on-surface truncate">Takumi Festival</span>
        <span class="font-label-sm text-label-sm text-on-surface-variant truncate">Sistem Manajemen Acara</span>
      </div>
    </div>
    <div class="px-space-md py-space-sm">
      <div class="flex items-center gap-space-xs px-space-sm py-space-xs rounded-lg bg-surface-container-low text-primary">
        <span class="material-symbols-outlined text-body-md">calendar_today</span>
        <span class="font-label-sm text-label-sm truncate">18 - 20 Oktober 2025</span>
      </div>
    </div>
    <nav class="flex-1 px-space-sm py-space-xs space-y-1 overflow-y-auto">
      {navItems.map((item) => (
        <a
          class={`flex items-center gap-space-sm px-space-sm py-space-sm transition-colors ${
            currentPage === item.path
              ? 'bg-surface-container-high text-primary font-title-sm rounded-lg'
              : 'rounded-lg text-on-surface-variant hover:bg-surface-container-low hover:text-on-surface'
          }`}
          data-path={item.path}
          href={item.href}
          aria-current={currentPage === item.path ? 'page' : undefined}
        >
          <span class="material-symbols-outlined text-body-lg">{item.icon}</span>
          <span class="font-body-md text-body-md">{item.label}</span>
        </a>
      ))}
    </nav>
    <div class="p-space-sm bg-surface-container-low m-space-sm rounded-lg flex items-center justify-between">
      <div class="flex items-center gap-space-xs">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        <span class="font-label-sm text-label-sm text-on-surface-variant">Sistem Aktif</span>
      </div>
      <span class="font-label-sm text-label-sm text-primary font-bold">v2.4</span>
    </div>
  </aside>

  <!-- Main Content Area -->
  <div class="pl-64">
    <!-- Header -->
    <header class="fixed top-0 left-64 right-0 h-16 bg-surface/85 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)] z-40 flex items-center justify-between px-gutter">
      <div class="flex items-center gap-space-sm">
        <nav class="flex items-center text-on-surface-variant font-label-md text-label-md">
          <span class="hover:text-primary transition-colors cursor-pointer">Festival</span>
          <span class="material-symbols-outlined text-body-sm mx-space-xs text-outline">chevron_right</span>
          <span class="text-primary font-title-sm text-title-sm">Operasional Acara</span>
        </nav>
      </div>
      <div class="flex items-center gap-space-md">
        <div class="hidden md:flex items-center gap-space-xs px-space-sm py-space-xs rounded-lg bg-surface-container-lowest text-on-surface-variant shadow-[0_1px_3px_rgba(51,65,85,0.04)]">
          <span class="material-symbols-outlined text-body-md">search</span>
          <span class="font-body-sm text-body-sm text-on-surface-variant pr-space-md">Cari data, rundown...</span>
          <kbd class="px-1.5 py-0.5 rounded bg-surface-container text-on-surface-variant font-label-sm text-label-sm">⌘K</kbd>
        </div>
        <button aria-label="Pemberitahuan" class="relative p-space-xs rounded-lg text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors" type="button">
          <span class="material-symbols-outlined text-body-lg">notifications</span>
          <span class="absolute top-1 right-1 w-2 h-2 rounded-full bg-error ring-2 ring-surface"></span>
        </button>
        <div class="flex items-center gap-space-sm pl-space-xs">
          <div class="flex flex-col text-right hidden sm:flex">
            <span class="font-title-sm text-title-sm text-on-surface leading-tight">Amalia Putri</span>
            <span class="font-label-sm text-label-sm text-on-surface-variant leading-tight">Koordinator Utama</span>
          </div>
          <img alt="Profile" class="w-8 h-8 rounded-full object-cover shadow-[0_1px_3px_rgba(51,65,85,0.1)]" src="https://lh3.googleusercontent.com/aida-public/AB6AXuA62YBSRcYd_P5JDF2HkDj_P7AoZQD5nsbHDhFcjTQKX-dSgzOwKx5dsBTZgwUPEiaDwBfYqhftwkCw-ETdU2XSx87km52gBo2yVp6yfCGM4gBVqP22V-a7jqNbzRJZnfftZoJGnCCHl6JLgEAkbrZqVHDbTPrcMXWmNmoywpo18VVPr4LFvZOCV0OZPGjgvH86aKF7f0ZuXwzIi91SHUGBLnQJC81Ky2X6vTmchim5K50uUrcjA4hB" />
        </div>
      </div>
    </header>

    <!-- Page Content -->
    <main class="w-full pt-16 bg-surface min-h-screen px-gutter pb-space-xl">
      <slot />
    </main>
  </div>

  <!-- Modal Root -->
  <div class="relative z-50" id="modal-root"></div>

  <!-- Toast Container -->
  <div class="fixed bottom-space-lg right-space-lg z-50 flex flex-col gap-space-sm pointer-events-none" id="toast-container"></div>

  <!-- Global Toast Function -->
  <script is:inline>
    function showToast(message, type) {
      const container = document.getElementById('toast-container');
      if (!container) return;

      const iconMap = {
        success: 'check_circle',
        error: 'error',
        info: 'info',
        warning: 'warning'
      };
      const icon = iconMap[type] || iconMap.success;

      const toast = document.createElement('div');
      toast.className = 'px-4 py-3 rounded-xl bg-inverse-surface text-inverse-on-surface shadow-xl flex items-center gap-2 font-label-md text-label-md pointer-events-auto transform transition-all duration-300 translate-y-2 opacity-0';
      toast.innerHTML = `
        <span class="material-symbols-outlined text-primary-fixed-dim text-body-md">${icon}</span>
        <span>${message}</span>
      `;
      container.appendChild(toast);

      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      });

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 3200);
    }
  </script>
</body>
</html>
